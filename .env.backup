DB_HOST=111.230.48.119
DB_PORT=5432
DB_NAME=rc_database
DB_USER=postgres
DB_PASSWORD=1q23l,Sc45+@!

# ===========================================
# 默认管理员账户
# ===========================================
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=Strive4it

# ===========================================
# AI服务配置
# ===========================================
# LlamaIndex Cloud API密钥
LLAMA_CLOUD_API_KEY=llx-1ZU9dynLO9R1uyEx2yo2JkjsmcLe7EKqBDVlsRRzUvhSIgYY

# ===========================================
# 市场数据服务配置
# ===========================================
# EODHD API密钥（用于获取新闻数据、经济事件和宏观指标）
# 获取方式：https://eodhd.com/cp/dashboard
EODHD_API_TOKEN=6496578e9b4187.14420379

# API_KEY 是EODHD_API_TOKEN的别名，用于向后兼容
API_KEY=6496578e9b4187.14420379

# EODHD 性能优化配置（可选，已设置默认的激进配置）
# 批处理大小：每次处理的股票数量
EODHD_BATCH_SIZE=2000

# 请求间隔：API请求之间的延迟（秒）
EODHD_REQUEST_DELAY=0.01

# 是否启用完整处理（生产环境建议为true）
EODHD_ENABLE_FULL_PROCESSING=true

# 速率限制监控
EODHD_ENABLE_RATE_LIMIT_MONITORING=true

# 速率限制重试次数
EODHD_MAX_RETRIES_ON_RATE_LIMIT=3

# 速率限制退避因子
EODHD_RATE_LIMIT_BACKOFF_FACTOR=2

# 🚀 TURBO MODE - 极限性能模式（警告：会显著增加API使用量）
# 启用后将使用最激进的配置设置
EODHD_TURBO_MODE=false

# 最大并发工作线程数
EODHD_MAX_WORKERS=50

# RC Agent默认任务令牌
RC_AGENT_TOKEN=your_rc_agent_token_here
RC_AGENT_TOKEN_default=your_rc_agent_token_here
RC_AGENT_NAME_default=默认任务

# ===========================================
# 服务间通信配置
# ===========================================
# 调度器服务地址（本地）
SCHEDULER_SERVICE_URL=http://localhost:8001

# 主Web应用地址（本地）
WEBAPP_URL=http://localhost:8000

# 前端应用地址（本地）
FRONTEND_URL=http://localhost:3000

# ===========================================
# 部署模式配置
# ===========================================
# 部署模式：unified（统一部署）
DEPLOYMENT_MODE=unified

# 服务器地址
SERVER_HOST=111.230.48.119

# ===========================================
# 用户会话配置
# ===========================================
# 上次登录的用户名（自动保存）
LAST_LOGIN_USERNAME=

# ===========================================
# 日志配置
# ===========================================
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_TO_CONSOLE=true
LOG_FILE_DAYS=30
LOG_DIR=logs

# ===========================================
# 前端配置（React应用）
# ===========================================
# API基础URL（相对于前端域名）
REACT_APP_API_BASE_URL=/api

# 调度器服务URL（前端直接访问）
REACT_APP_SCHEDULER_BASE_URL=http://localhost:8001

# ali云aip key
DASHSCOPE_API_KEY=sk-d3727036c34d4fdc9ba17ed3b93475ec

# ===========================================
# 阿里云 OSS 配置（用于音频文件上传）
# ===========================================
# OSS AccessKey ID 和 Secret（已从阿里云控制台获取）
OSS_ACCESS_KEY_ID=LTAI5tAgj7dux4ADLBJ9higC
OSS_ACCESS_KEY_SECRET=HOcJQfft0lx2IMecEvq8Ru7AulPUtA

# OSS Bucket 配置（Bucket 位于深圳地域）
OSS_BUCKET_NAME=rc-audio-files
OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com

# OSS 存储路径前缀
OSS_AUDIO_PREFIX=audio/

# ===========================================
# 说明
# ===========================================
# 1. 此配置适用于全服务器统一部署
# 2. 所有服务都在同一服务器上运行
# 3. 服务间通过localhost通信
# 4. 数据库和调度器独立运行
# 5. 请根据实际情况修改API密钥等敏感信息
# ============================================================
# ASR 节点配置模板 — 香港家用机（WORKER_NODE_ROLE=asr）
#
# 职责: youtube_transcription*（yt-dlp 音频下载 + OSS + Fun-ASR）
# 部署:
#   cp .env.template.asr .env
#   nano .env
#   bash setup.sh
#
# 详见 DEPLOY_DUAL_NODE.md
# ============================================================


# ============================================================
# 一、主站连接（必填）
# ============================================================

DB_HOST=<香港主站-ip>
DB_PORT=5432
DB_NAME=<your-db-name>
DB_USER=postgres
DB_PASSWORD=<your-db-password>

REDIS_URL=redis://:<URL编码后的Redis密码>@<香港主站-ip>:6379/0


# ============================================================
# 二、节点角色（勿改）
# ============================================================

WORKER_NODE_ROLE=asr

# 家用带宽有限，三项并发均保持 1
WORKER_ASR_CONCURRENCY=1
WORKER_ASR_MAX_TASKS_PER_CHILD=20
WORKER_LONG_CONCURRENCY=1
WORKER_LONG_MAX_TASKS_PER_CHILD=10
WORKER_PRIORITY_ASR_CONCURRENCY=1
WORKER_PRIORITY_MAX_TASKS_PER_CHILD=20
WORKER_LOG_LEVEL=info


# ============================================================
# 三、OSS + Fun-ASR（ASR 节点必填）
# ============================================================

OSS_ACCESS_KEY_ID=<your-key>
OSS_ACCESS_KEY_SECRET=<your-secret>
OSS_BUCKET_NAME=<your-bucket>
OSS_ENDPOINT=oss-cn-hongkong.aliyuncs.com
OSS_ASR_PUBLIC_READ=false
OSS_SIGNED_URL_TTL_SECONDS=172800

# 家用上行带宽保护：同一时刻只有一个进程上传 OSS
OSS_UPLOAD_LOCK_FILE=/tmp/yt_worker_oss_upload.lock
OSS_UPLOAD_LOCK_TIMEOUT_SECONDS=60

DASHSCOPE_API_KEY=<your-dashscope-key>


# ============================================================
# 四、yt-dlp 下载（住宅 IP 直连，不走 Webshare）
# ============================================================

YTDLP_ENABLED=true
CAPTION_ASR_FALLBACK_ENABLED=true
# 本节点不跑字幕抓取，此项无实际影响
CAPTION_YTDLP_FALLBACK_ENABLED=false

# 强烈建议配置，提升下载成功率
# YOUTUBE_COOKIES_FILE=/opt/local_virtual_service/secrets/youtube_cookies.txt
# YOUTUBE_PO_TOKEN=
# YOUTUBE_VISITOR_DATA=

YTDLP_SOCKET_TIMEOUT_SECONDS=30
YTDLP_RETRIES=5
YTDLP_FRAGMENT_RETRIES=5
YTDLP_IMPERSONATE=auto


# ============================================================
# 五、长视频路由与 ASR 超时
# ============================================================

ASR_LONG_VIDEO_THRESHOLD_SECONDS=1800
ASR_LONG_TASK_TIME_LIMIT_SECONDS=21600
ASR_LONG_TASK_SOFT_TIME_LIMIT_SECONDS=19800

ASR_MAX_RETRIES=1
ASR_RETRY_BACKOFF_BASE_SECONDS=120
ASR_RETRY_BACKOFF_MAX_SECONDS=600

ASR_POLL_TIMEOUT_MINUTES=5
ASR_POLL_TIMEOUT_MINUTES_LONG=60

TASK_TIME_LIMIT_SECONDS=7200
TASK_SOFT_TIME_LIMIT_SECONDS=6600
RESULT_EXPIRES_SECONDS=3600


# ============================================================
# 六、本节点不需要的配置
# ============================================================
# 不要配置 Webshare（音频下载流量 MB 级，代理费用极高）：
#   WEBSHARE_PROXY_USERNAME / WEBSHARE_PROXY_PASSWORD


# ============================================================
# 七、监控告警
# ============================================================

# LARK_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/<your-token>
HEALTH_ALERT_PREFIX=[HK-ASR-Worker]
HEALTH_ASR_BACKLOG_THRESHOLD=5
HEALTH_LONG_BACKLOG_THRESHOLD=3
HEALTH_PRIORITY_BACKLOG_THRESHOLD=5
HEALTH_RESTART_ON_BACKLOG=false
HEALTH_CELERY_PING_TIMEOUT=5
HEALTH_ALERT_REPEAT_MINUTES=60

LOG_DIR=./logs
LOG_LEVEL=INFO

# ============================================================
# 字幕节点配置模板 — 新加坡 VPS（WORKER_NODE_ROLE=caption）
#
# 职责: youtube_fetching + youtube_priority（Webshare 字幕，不下载视频）
# 部署:
#   cp .env.template.caption .env
#   nano .env
#   bash setup.sh
#
# 详见 DEPLOY_DUAL_NODE.md
# ============================================================


# ============================================================
# 一、主站连接（必填）
# ============================================================

DB_HOST=<香港主站-ip>
DB_PORT=5432
DB_NAME=<your-db-name>
DB_USER=postgres
DB_PASSWORD=<your-db-password>

# Redis 密码特殊字符需 URL 编码: , → %2C  + → %2B  @ → %40  ! → %21
REDIS_URL=redis://:<URL编码后的Redis密码>@<香港主站-ip>:6379/0


# ============================================================
# 二、节点角色（勿改）
# ============================================================

WORKER_NODE_ROLE=caption

WORKER_FETCH_CONCURRENCY=1
WORKER_FETCH_MAX_TASKS_PER_CHILD=20
WORKER_PRIORITY_TRANSCRIPT_CONCURRENCY=1
WORKER_PRIORITY_MAX_TASKS_PER_CHILD=20
WORKER_LOG_LEVEL=info


# ============================================================
# 三、Webshare 住宅代理（字幕节点强烈建议启用）
# ============================================================
# 仅作用于 transcript-api 与 yt-dlp 字幕回退（KB 级流量）。
# 切勿写入 HTTPS_PROXY / HTTP_PROXY（会让 OSS 等大流量也走代理）。

WEBSHARE_PROXY_USERNAME=<your-username>
WEBSHARE_PROXY_PASSWORD=<your-password>
WEBSHARE_FILTER_IP_LOCATIONS=jp,tw,sg,us

# yt-dlp 字幕回退也走 Webshare（与 transcript-api 同账号）
CAPTION_YTDLP_USE_WEBSHARE=true


# ============================================================
# 四、字幕链路开关
# ============================================================

YTDLP_ENABLED=true
CAPTION_YTDLP_FALLBACK_ENABLED=true
# 字幕失败时派发 ASR 到香港节点；本机不消费 ASR 队列
CAPTION_ASR_FALLBACK_ENABLED=true

CAPTION_YTDLP_TIMEOUT_SECONDS=60
CAPTION_YTDLP_SLEEP_SUBTITLES_SECONDS=0.5
CAPTION_YTDLP_SLEEP_REQUESTS_SECONDS=0.5

# 本节点不需要 cookies（可选，略提字幕成功率）
# YOUTUBE_COOKIES_FILE=/opt/local_virtual_service/secrets/youtube_cookies.txt

# RSS 不可用时的 Data API 回退（可选）
# YOUTUBE_DATA_API_KEY=


# ============================================================
# 五、超时与网络
# ============================================================

YOUTUBE_TRANSCRIPT_TIMEOUT_SECONDS=60
YOUTUBE_FEED_TIMEOUT_SECONDS=5
YOUTUBE_FEED_MAX_RETRIES=3

YTDLP_SOCKET_TIMEOUT_SECONDS=30
YTDLP_RETRIES=5
YTDLP_FRAGMENT_RETRIES=5
YTDLP_IMPERSONATE=auto

TASK_TIME_LIMIT_SECONDS=7200
TASK_SOFT_TIME_LIMIT_SECONDS=6600
RESULT_EXPIRES_SECONDS=3600


# ============================================================
# 六、本节点不需要的配置（ASR 在香港节点执行）
# ============================================================
# 以下留空即可，不要在新加坡配置 OSS / DashScope：
#   OSS_ACCESS_KEY_ID / OSS_BUCKET_NAME / DASHSCOPE_API_KEY


# ============================================================
# 七、监控告警
# ============================================================

# LARK_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/<your-token>
HEALTH_ALERT_PREFIX=[SG-Caption-Worker]
HEALTH_FETCH_BACKLOG_THRESHOLD=10
HEALTH_PRIORITY_BACKLOG_THRESHOLD=5
HEALTH_RESTART_ON_BACKLOG=false
HEALTH_ALERT_REPEAT_MINUTES=60

LOG_DIR=./logs
LOG_LEVEL=INFO

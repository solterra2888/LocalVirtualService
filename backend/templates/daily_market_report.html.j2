<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Daily Market Report - {{ report_date }}</title>
<style>
/* === RESET & BASE === */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
    --bg-page: #ffffff;
    --bg-card: #ffffff;
    --bg-header: linear-gradient(90deg, #2d4a6f 0%, #1e3a5f 100%);
    --bg-table-header: linear-gradient(180deg, #1e3a5f 0%, #152d4a 100%);
    --bg-hover: #f0f4f8;
    --text-primary: #111111;
    --text-secondary: #3d4f5f;
    --text-muted: #6b7a8a;
    --text-header: #ffffff;
    --text-tab: rgba(255,255,255,0.65);
    --text-tab-active: #ffffff;
    --border: rgba(224, 224, 224, 0.6);
    --border-subtle: #e8ecf1;
    --color-pos: #0a7c42;
    --color-neg: #c41230;
    --color-neutral: #888;
    --tab-active-border: #ffffff;
    --tab-hover-bg: rgba(255,255,255,0.1);
    --shadow-card: 0 2px 12px rgba(0,0,0,0.06);
}

[data-theme="dark"] {
    --bg-page: #0B0E14;
    --bg-card: #141820;
    --bg-header: linear-gradient(90deg, #1a2235 0%, #141820 100%);
    --bg-table-header: linear-gradient(180deg, #1a2235 0%, #111622 100%);
    --bg-hover: #1e2536;
    --text-primary: #edf0f4;
    --text-secondary: #a3adbc;
    --text-muted: #727f92;
    --text-header: #edf0f4;
    --text-tab: rgba(255,255,255,0.45);
    --text-tab-active: #6dacf0;
    --border: rgba(60, 70, 90, 0.5);
    --border-subtle: rgba(60, 70, 90, 0.3);
    --color-pos: #00e676;
    --color-neg: #ff5252;
    --color-neutral: #727f92;
    --tab-active-border: #6dacf0;
    --tab-hover-bg: rgba(255,255,255,0.05);
    --shadow-card: 0 2px 16px rgba(0,0,0,0.3);
}

html { font-size: 15px; }
body {
    font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', Roboto, sans-serif;
    background: var(--bg-page);
    color: var(--text-primary);
    line-height: 1.5;
    min-height: 100vh;
}

/* === HEADER === */
.report-header {
    background: var(--bg-header);
    padding: 20px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
}
.report-header h1 {
    color: var(--text-header);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.01em;
}
.report-header-right {
    display: flex;
    align-items: center;
    gap: 16px;
    color: var(--text-header);
    font-size: 0.85rem;
    opacity: 0.8;
}
.theme-toggle {
    background: rgba(255,255,255,0.15);
    border: none;
    color: white;
    padding: 4px 10px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 1rem;
}

/* === SECTION BAR === */
.section-bar {
    background: var(--bg-header);
    padding: 10px 28px;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-header);
    letter-spacing: 0.02em;
}

/* === TAB NAVIGATION === */
.tab-nav {
    background: var(--bg-header);
    padding: 0 28px;
    display: flex;
    gap: 0;
    border-bottom: 1px solid rgba(255,255,255,0.1);
}
.tab-btn {
    background: none;
    border: none;
    color: var(--text-tab);
    padding: 10px 20px;
    font-size: 0.88rem;
    font-weight: 500;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: all 0.2s;
    font-family: inherit;
}
.tab-btn:hover {
    color: var(--text-tab-active);
    background: var(--tab-hover-bg);
}
.tab-btn.active {
    color: var(--text-tab-active);
    border-bottom-color: var(--tab-active-border);
    font-weight: 600;
}

/* === SUMMARY CONTENT (rendered Markdown) === */
.summary-content {
    background: var(--bg-card);
    border-radius: 8px;
    box-shadow: var(--shadow-card);
    padding: 28px 32px;
    line-height: 1.75;
    color: var(--text-primary);
    font-size: 0.9rem;
}
.summary-content h1 {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 24px 0 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border-subtle);
}
.summary-content h1:first-child { margin-top: 0; }
.summary-content h2 {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 20px 0 10px;
}
.summary-content h3 {
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin: 16px 0 8px;
}
.summary-content p {
    margin: 8px 0;
    color: var(--text-secondary);
}
.summary-content ul, .summary-content ol {
    margin: 8px 0;
    padding-left: 24px;
    color: var(--text-secondary);
}
.summary-content li { margin: 4px 0; }
.summary-content strong {
    color: var(--text-primary);
    font-weight: 600;
}
.summary-content blockquote {
    border-left: 3px solid var(--border);
    margin: 12px 0;
    padding: 8px 16px;
    color: var(--text-muted);
    font-style: italic;
}
.summary-content table {
    margin: 12px 0;
    font-size: 13px;
    /* Markdown content tables (Close Brief / Stock Pulse / Feed Digest) wrap
       cell text instead of inheriting the global `white-space: nowrap`
       Market-Movers rule. Without this, the wide YouTube / 知识星球 summary
       tables blow past the page width. */
    table-layout: auto;
}
.summary-content th, .summary-content td {
    padding: 8px 12px;
    /* Override the global data-grid defaults (right-aligned + nowrap) — these
       are prose/content tables, not numeric Market-Movers tables. */
    text-align: left;
    vertical-align: top;
    white-space: normal;
    overflow-wrap: break-word;
}
.summary-content th {
    white-space: nowrap; /* keep short header labels on a single line */
}
.summary-content code {
    font-family: 'SF Mono', 'Fira Code', 'Consolas', monospace;
    background: var(--bg-hover);
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 0.88em;
}
.summary-content hr {
    border: none;
    border-top: 1px solid var(--border-subtle);
    margin: 20px 0;
}

/* === EMPTY STATE === */
.summary-empty {
    text-align: center;
    padding: 60px 20px;
    color: var(--text-muted);
}
.summary-empty .empty-icon {
    font-size: 2.5rem;
    margin-bottom: 12px;
    opacity: 0.4;
}
.summary-empty .empty-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 6px;
}
.summary-empty .empty-desc {
    font-size: 0.85rem;
}

/* === MARKET SECTIONS === */
.market-section { margin-bottom: 32px; }

/* === CONTENT === */
.content { max-width: 1280px; margin: 0 auto; padding: 24px 28px; }
.tab-panel { display: none; }
.tab-panel.active { display: block; }

/* === TABLE === */
.table-title {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 12px;
}

/* Horizontal scroll wrapper: lets the 13-column Market Overview tables swipe
   left/right on mobile while keeping the section title (US ASSETS, etc.) fixed. */
.table-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
}

table {
    width: 100%;
    border-collapse: collapse;
    font-size: 11px;
    background: var(--bg-card);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: var(--shadow-card);
}

thead tr {
    background: var(--bg-table-header);
}
th {
    padding: 10px 12px;
    text-align: right;
    font-weight: 600;
    font-size: 11px;
    color: rgba(255,255,255,0.9);
    white-space: nowrap;
    cursor: pointer;
    user-select: none;
    position: relative;
}
th:hover { background: rgba(255,255,255,0.08); }
th .sort-arrow { font-size: 0.65rem; margin-left: 3px; opacity: 0.4; }
th.sorted .sort-arrow { opacity: 1; }
th.col-ticker, th.col-name { text-align: left; }

td {
    padding: 9px 12px;
    text-align: right;
    border-bottom: 1px solid var(--border-subtle);
    white-space: nowrap;
}
td.col-ticker {
    text-align: left;
    font-weight: 600;
    color: var(--text-primary);
    font-family: 'SF Mono', 'Fira Code', 'Consolas', monospace;
    font-size: 11px;
}
td.col-name {
    text-align: left;
    color: var(--text-secondary);
    font-weight: 400;
}

/* === VALUE STYLING === */
.val-pos { color: var(--color-pos); }
.val-neg { color: var(--color-neg); }
.val-neutral { color: var(--color-neutral); }
.val-na { color: var(--text-muted); font-style: italic; }
td.price-cell { font-weight: 500; font-family: 'SF Mono', 'Fira Code', 'Consolas', monospace; }
td.rsi-cell { font-family: 'SF Mono', 'Fira Code', 'Consolas', monospace; }

tbody tr:hover { background: var(--bg-hover); }

/* === CHART VIEWER === */
.chart-viewer {
    margin-top: 16px;
    background: var(--bg-card);
    border-radius: 8px;
    box-shadow: var(--shadow-card);
    overflow: hidden;
}
.chart-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    border-bottom: 1px solid var(--border-subtle);
    background: var(--bg-card);
}
.chart-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
}
.chart-label .chart-ticker {
    font-family: 'SF Mono', 'Fira Code', 'Consolas', monospace;
    color: var(--text-primary);
}
.chart-label .chart-name {
    color: var(--text-secondary);
    font-weight: 400;
    margin-left: 6px;
    font-size: 0.82rem;
}
.chart-controls {
    display: flex;
    align-items: center;
    gap: 4px;
}
.chart-range-btn {
    background: none;
    border: 1px solid var(--border);
    color: var(--text-secondary);
    padding: 3px 10px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 500;
    transition: all 0.15s;
}
.chart-range-btn:hover { background: var(--bg-hover); color: var(--text-primary); }
.chart-range-btn.active { background: var(--bg-hover); color: var(--text-primary); border-color: var(--text-muted); }
.chart-close-btn {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    font-size: 1.1rem;
    padding: 2px 8px;
    border-radius: 4px;
    transition: all 0.15s;
}
.chart-close-btn:hover { background: var(--bg-hover); color: var(--text-primary); }
.chart-ma-btn {
    background: none;
    border: 1px solid transparent;
    padding: 3px 8px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.7rem;
    font-weight: 600;
    opacity: 0.4;
    transition: all 0.15s;
}
.chart-ma-btn:hover { opacity: 0.7; }
.chart-ma-btn.active { opacity: 1; border-color: currentColor; }
.chart-container {
    height: 380px;
    padding: 0 4px;
}
.chart-nav-hint {
    font-size: 0.7rem;
    color: var(--text-muted);
    padding: 0 16px 8px;
    text-align: center;
}
tbody tr.chart-row { cursor: pointer; }
tbody tr.chart-active { background: var(--bg-hover); }

/* === INDEX PERFORMERS === */
.contrib-controls {
    display: flex;
    gap: 14px;
    align-items: center;
    flex-wrap: wrap;
}
.contrib-btn-group { display: flex; gap: 4px; }
.contrib-controls .chart-range-btn { padding: 3px 10px; font-size: 0.72rem; }
.contrib-panel { margin-top: 14px; }
.contrib-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
}
.contrib-column {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 10px 12px 12px;
    box-shadow: var(--shadow-card);
}
.contrib-column-header {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-align: center;
    padding-bottom: 8px;
    margin-bottom: 6px;
    border-bottom: 1px solid var(--border-subtle);
}
.contrib-table-title {
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    margin: 10px 0 4px;
}
.contrib-table-title.top { color: var(--color-pos); }
.contrib-table-title.bottom { color: var(--color-neg); }
.contrib-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 11px;
    background: transparent;
    border-radius: 0;
    box-shadow: none;
}
.contrib-table thead tr { background: transparent; }
.contrib-table th {
    padding: 5px 6px;
    text-align: right;
    font-size: 0.66rem;
    font-weight: 600;
    color: var(--text-muted);
    cursor: default;
    border-bottom: 1px solid var(--border-subtle);
    background: var(--bg-hover);
}
.contrib-table th:first-child { text-align: left; }
.contrib-table th:hover { background: var(--bg-hover); }
.contrib-table td {
    padding: 5px 6px;
    text-align: right;
    font-size: 11px;
    border-bottom: 1px solid var(--border-subtle);
    white-space: nowrap;
}
.contrib-table td.col-ticker {
    text-align: left;
    font-weight: 600;
    font-family: 'SF Mono', 'Fira Code', 'Consolas', monospace;
}
.contrib-table td.col-ticker a { color: var(--text-primary); text-decoration: none; }
.contrib-table td.col-ticker a:hover { text-decoration: underline; }
.ip-empty {
    padding: 18px;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.85rem;
    background: var(--bg-card);
    border: 1px dashed var(--border);
    border-radius: 8px;
}
@media (max-width: 900px) {
    .contrib-row { grid-template-columns: 1fr; }
}

/* === PERFORMANCE CHARTS TAB === */
.perf-section { margin-bottom: 24px; }
.perf-section:last-child { margin-bottom: 0; }
.perf-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    background: var(--bg-card);
    border-radius: 8px 8px 0 0;
    border-bottom: 1px solid var(--border-subtle);
}
.perf-section-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
}
.perf-range-btns {
    display: flex;
    gap: 4px;
}
.perf-viewer {
    background: var(--bg-card);
    overflow: hidden;
}
.perf-viewer .chart-container { height: 380px; }
.perf-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    padding: 10px 16px;
    background: var(--bg-card);
    border-radius: 0 0 8px 8px;
    border-top: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-card);
}
.perf-legend-item {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.72rem;
    color: var(--text-secondary);
    cursor: pointer;
    padding: 2px 6px;
    border-radius: 3px;
    transition: opacity 0.15s;
    user-select: none;
}
.perf-legend-item:hover { background: var(--bg-hover); }
.perf-legend-item .perf-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
}
.perf-legend-item .perf-ticker {
    font-family: 'SF Mono', 'Fira Code', 'Consolas', monospace;
    font-weight: 600;
    font-size: 0.72rem;
}
.perf-legend-item .perf-name {
    font-size: 0.68rem;
    color: var(--text-muted);
}
.perf-legend-item .perf-pct {
    font-size: 0.7rem;
    font-weight: 500;
}
.perf-legend-item.hidden {
    opacity: 0.35;
    text-decoration: line-through;
}

/* === NOTES SECTION === */
.notes-section {
    margin-top: 20px;
    background: var(--bg-card);
    border-radius: 8px;
    box-shadow: var(--shadow-card);
    overflow: hidden;
}
.notes-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-secondary);
    background: var(--bg-card);
    border-bottom: 1px solid var(--border-subtle);
    user-select: none;
    transition: background 0.15s;
}
.notes-toggle:hover { background: var(--bg-hover); }
.notes-toggle .toggle-arrow {
    font-size: 0.7rem;
    transition: transform 0.2s;
    color: var(--text-muted);
}
.notes-toggle.open .toggle-arrow { transform: rotate(180deg); }
.notes-content { display: none; padding: 4px 0; }
.notes-content.open { display: block; }
.note-item {
    padding: 10px 16px;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.82rem;
    line-height: 1.7;
    color: var(--text-secondary);
}
.note-item:last-child { border-bottom: none; }
.note-item .note-title {
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 4px;
}
.note-item .note-title .note-ticker {
    font-family: 'SF Mono', 'Fira Code', 'Consolas', monospace;
    color: var(--text-primary);
    font-weight: 700;
}
.note-item .note-detail { margin-top: 2px; }
.note-item .note-detail strong {
    color: var(--text-primary);
    font-weight: 600;
}

/* === MARKET TEMPERATURE === */
.mt-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 20px;
}
.mt-toolbar-hint {
    font-size: 0.8rem;
    color: var(--text-muted);
}
.mt-country-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin: 14px 0 8px;
}
.mt-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 14px;
}
.mt-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    box-shadow: var(--shadow-card);
    padding: 12px 14px 8px;
    display: flex;
    flex-direction: column;
}
.mt-card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 6px;
}
.mt-card-title {
    display: flex;
    align-items: baseline;
    gap: 6px;
    min-width: 0;
}
.mt-card-label {
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--text-primary);
    white-space: nowrap;
}
a.mt-card-label {
    color: var(--text-primary);
    text-decoration: none;
    cursor: pointer;
}
a.mt-card-label:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
}
a.mt-card-label::after {
    content: '↗';
    font-size: 0.62rem;
    color: var(--text-muted);
    margin-left: 3px;
    text-decoration: none;
    display: inline-block;
    transform: translateY(-1px);
}
.mt-card-sub {
    font-size: 0.68rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.mt-card-quote {
    display: flex;
    align-items: baseline;
    gap: 6px;
    white-space: nowrap;
}
.mt-card-last {
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--text-primary);
    font-family: 'SF Mono', 'Fira Code', 'Consolas', monospace;
}
.mt-card-quote .val-pos, .mt-card-quote .val-neg, .mt-card-quote .val-neutral {
    font-size: 0.74rem;
    font-family: 'SF Mono', 'Fira Code', 'Consolas', monospace;
}
.mt-chart {
    height: 160px;
    width: 100%;
}
.mt-chart-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    color: var(--text-muted);
    border: 1px dashed var(--border-subtle);
    border-radius: 6px;
}

/* === FOOTER === */
.footer {
    max-width: 1280px;
    margin: 24px auto 40px;
    padding: 0 28px;
    color: var(--text-muted);
    font-size: 0.78rem;
    line-height: 1.7;
}
.footer p { margin-bottom: 4px; }

/* === RESPONSIVE === */
@media (max-width: 768px) {
    .report-header { padding: 14px 16px; }
    .section-bar { padding: 8px 12px; font-size: 0.85rem; }
    .content { padding: 16px; }
    table { font-size: 11px; }
    th, td { padding: 7px 8px; }
    .tab-nav { padding: 0 12px; overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .tab-btn { padding: 8px 12px; font-size: 0.82rem; white-space: nowrap; flex-shrink: 0; }
    .summary-content { padding: 16px 18px; }
    /* Keep the 13-column Market Overview tables at full width and swipe horizontally */
    .table-scroll > table { min-width: 720px; }
    /* Markdown tables (Home / Stockview / Subscription) also swipe when too wide */
    .summary-content table { display: block; max-width: 100%; overflow-x: auto; }
    /* Market Temperature: single-column cards on mobile */
    .mt-grid { grid-template-columns: 1fr; }
}
</style>
</head>
<body>

<div class="report-header">
    <h1>Daily Market Report</h1>
    <div class="report-header-right">
        <span>{{ report_date }}</span>
        <button class="theme-toggle" onclick="toggleTheme()">&#9790;</button>
    </div>
</div>

<div class="tab-nav">
    <button class="tab-btn active" data-tab="temperature" onclick="switchTab('temperature')">Temperature</button>
    <button class="tab-btn" data-tab="home" onclick="switchTab('home')">Close Brief</button>
    <button class="tab-btn" data-tab="stockview" onclick="switchTab('stockview')">Stock Pulse</button>
    <button class="tab-btn" data-tab="my-subscription" onclick="switchTab('my-subscription')">Feed Digest</button>
    <button class="tab-btn" data-tab="market-overview" onclick="switchTab('market-overview')">Market Movers</button>
</div>

<div class="content">

{# ── Temperature Tab: Market Temperature (市场温度感知) ── #}
<div class="tab-panel active" id="panel-temperature">
<div class="mt-toolbar">
    <span class="mt-toolbar-hint">Global daily trends by asset class</span>
    <div class="chart-controls" id="mt-range">
        <button class="chart-range-btn active" data-range="3m" onclick="setTempRange('3m', this)">3M</button>
        <button class="chart-range-btn" data-range="6m" onclick="setTempRange('6m', this)">6M</button>
        <button class="chart-range-btn" data-range="1y" onclick="setTempRange('1y', this)">1Y</button>
    </div>
</div>

{% for group in temperature_groups %}
<div class="market-section" id="mt-section-{{ group.key }}">
    <div class="table-title">{{ group.label }}</div>
    {% if group.countries is defined %}
        {% for country in group.countries %}
    <div class="mt-country-label">{{ country.label }}</div>
    <div class="mt-grid">
        {% for card_id, label, code, sublabel, tv_symbol in country.cards %}
        {% set card = temperature_cards | selectattr('id', 'equalto', card_id) | first %}
        <div class="mt-card" data-mt-id="{{ card_id }}">
            <div class="mt-card-head">
                <div class="mt-card-title">
                    <a class="mt-card-label" href="https://www.tradingview.com/chart/?symbol={{ tv_symbol | urlencode }}&interval=D&range=6M" target="_blank" rel="noopener noreferrer" title="Open {{ label }} in TradingView">{{ label }}</a>
                    {% if sublabel %}<span class="mt-card-sub">{{ sublabel }}</span>{% endif %}
                </div>
                <div class="mt-card-quote">
                    {% if card and card.last is not none %}
                    <span class="mt-card-last">{{ '%.2f' | format(card.last) }}</span>
                    {% if card.chg_pct is not none %}
                    <span class="{{ 'val-pos' if card.chg_pct > 0 else ('val-neg' if card.chg_pct < 0 else 'val-neutral') }}">{{ '+' if card.chg_pct > 0 }}{{ '%.2f' | format(card.chg_pct) }}%</span>
                    {% endif %}
                    {% else %}
                    <span class="val-na">N/A</span>
                    {% endif %}
                </div>
            </div>
            {% if card and card.bars %}
            <div class="mt-chart" id="mt-chart-{{ card_id }}"></div>
            {% else %}
            <div class="mt-chart mt-chart-empty">No data</div>
            {% endif %}
        </div>
        {% endfor %}
    </div>
        {% endfor %}
    {% else %}
    <div class="mt-grid">
        {% for card_id, label, code, sublabel, tv_symbol in group.cards %}
        {% set card = temperature_cards | selectattr('id', 'equalto', card_id) | first %}
        <div class="mt-card" data-mt-id="{{ card_id }}">
            <div class="mt-card-head">
                <div class="mt-card-title">
                    <a class="mt-card-label" href="https://www.tradingview.com/chart/?symbol={{ tv_symbol | urlencode }}&interval=D&range=6M" target="_blank" rel="noopener noreferrer" title="Open {{ label }} in TradingView">{{ label }}</a>
                    {% if sublabel %}<span class="mt-card-sub">{{ sublabel }}</span>{% endif %}
                </div>
                <div class="mt-card-quote">
                    {% if card and card.last is not none %}
                    <span class="mt-card-last">{{ '%.2f' | format(card.last) }}</span>
                    {% if card.chg_pct is not none %}
                    <span class="{{ 'val-pos' if card.chg_pct > 0 else ('val-neg' if card.chg_pct < 0 else 'val-neutral') }}">{{ '+' if card.chg_pct > 0 }}{{ '%.2f' | format(card.chg_pct) }}%</span>
                    {% endif %}
                    {% else %}
                    <span class="val-na">N/A</span>
                    {% endif %}
                </div>
            </div>
            {% if card and card.bars %}
            <div class="mt-chart" id="mt-chart-{{ card_id }}"></div>
            {% else %}
            <div class="mt-chart mt-chart-empty">No data</div>
            {% endif %}
        </div>
        {% endfor %}
    </div>
    {% endif %}
</div>
{% endfor %}
</div>

{# ── Home Tab: Bloomberg The Close Summary ── #}
<div class="tab-panel" id="panel-home">
{% if the_close_html %}
    <div class="summary-content">
        {{ the_close_html | safe }}
    </div>
{% else %}
    <div class="summary-empty">
        <div class="empty-icon">📊</div>
        <div class="empty-title">Bloomberg The Close 摘要暂未生成</div>
        <div class="empty-desc">当日 PM Brief 尚未生成，可能是非交易日或数据管线尚未完成。</div>
    </div>
{% endif %}
</div>

{# ── Stockview Tab: CNBC Closing Bell Summary ── #}
<div class="tab-panel" id="panel-stockview">
{% if closing_bell_html %}
    <div class="summary-content">
        {{ closing_bell_html | safe }}
    </div>
{% else %}
    <div class="summary-empty">
        <div class="empty-icon">📰</div>
        <div class="empty-title">CNBC Closing Bell 摘要暂未生成</div>
        <div class="empty-desc">当日 Stock News 摘要尚未生成，可能是非交易日或数据管线尚未完成。</div>
    </div>
{% endif %}
</div>

{# ── My Subscription Tab: 知识星球 + Twitter + YouTube 每日摘要 ── #}
<div class="tab-panel" id="panel-my-subscription">
{% if my_subscriptions_html %}
    <div class="summary-content">
        {{ my_subscriptions_html | safe }}
    </div>
{% else %}
    <div class="summary-empty">
        <div class="empty-icon">📬</div>
        <div class="empty-title">暂无订阅摘要</div>
        <div class="empty-desc">当日知识星球、Twitter、YouTube 摘要尚未生成，或该用户无订阅数据。</div>
    </div>
{% endif %}
</div>

{# ── Market Overview Tab: US Assets / Sector / Thematic tables ── #}

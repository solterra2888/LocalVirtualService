                <td class="price-cell" data-val="{{ row.price }}">{{ row.price|fmt_price }}</td>
                <td data-val="{{ row.day }}">{{ row.day|fmt_pct }}</td>
                <td data-val="{{ row.open }}">{{ row.open|fmt_pct }}</td>
                <td data-val="{{ row.gap }}">{{ row.gap|fmt_pct }}</td>
                <td data-val="{{ row.week }}">{{ row.week|fmt_pct }}</td>
                <td data-val="{{ row.month }}">{{ row.month|fmt_pct }}</td>
                <td data-val="{{ row.y }}">{{ row.y|fmt_pct }}</td>
                <td data-val="{{ row.sma20 }}">{{ row.sma20|fmt_pct }}</td>
                <td data-val="{{ row.sma50 }}">{{ row.sma50|fmt_pct }}</td>
                <td data-val="{{ row.sma200 }}">{{ row.sma200|fmt_pct }}</td>
                <td class="rsi-cell" data-val="{{ row.rsi }}">{{ row.rsi|fmt_rsi }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>

    <div class="chart-viewer" id="chart-viewer-us-assets" style="display:none">
        <div class="chart-header">
            <span class="chart-label"><span class="chart-ticker" id="chart-ticker-us-assets"></span><span class="chart-name" id="chart-name-us-assets"></span></span>
            <div class="chart-controls">
                <button class="chart-range-btn active" data-range="3m" onclick="setChartRange('us-assets','3m',this)">3M</button>
                <button class="chart-range-btn" data-range="6m" onclick="setChartRange('us-assets','6m',this)">6M</button>
                <button class="chart-range-btn" data-range="all" onclick="setChartRange('us-assets','all',this)">All</button>
                <span style="width:1px;height:16px;background:var(--border-subtle);margin:0 6px;display:inline-block"></span>
                <button class="chart-ma-btn active" data-ma="20" onclick="toggleMA('us-assets',20,this)" style="color:#f59e0b">MA20</button>
                <button class="chart-ma-btn active" data-ma="50" onclick="toggleMA('us-assets',50,this)" style="color:#3b82f6">MA50</button>
                <button class="chart-ma-btn" data-ma="200" onclick="toggleMA('us-assets',200,this)" style="color:#a855f7">MA200</button>
                <button class="chart-close-btn" onclick="closeChart('us-assets')" title="Close">✕</button>
            </div>
        </div>
        <div class="chart-container" id="chart-container-us-assets"></div>
        <div class="chart-nav-hint">← → navigate between tickers · Esc to close</div>
    </div>

    {# ── US Assets Notes ── #}
    <div class="notes-section">
        <div class="notes-toggle" onclick="toggleNotes('us-assets-notes')">
            <span>📖 ETF 说明（点击展开）</span>
            <span class="toggle-arrow">▼</span>
        </div>
        <div class="notes-content" id="us-assets-notes">
        {% for ticker, note in us_assets_notes.items() %}
            <div class="note-item">
                <div class="note-title">
                    <span class="note-ticker">{{ ticker }}</span>（{{ note.name }}）：代表"{{ note.represents }}"
                </div>
                <div class="note-detail">
                    <strong>跟踪标的：</strong>{{ note.index }}<br>
                    <strong>特点：</strong>{{ note.description }}
                </div>
            </div>
        {% endfor %}
        </div>
    </div>
</div>


{# ── Performance Charts Section ── #}
<div class="market-section" id="section-performance">

    <div class="perf-section">
        <div class="perf-section-header">
            <span class="perf-section-title">US Index ETFs</span>
            <div class="perf-range-btns" id="perf-range-index">
                <button class="chart-range-btn active" data-range="6m" onclick="setPerfRange('index','6m',this)">6M</button>
                <button class="chart-range-btn" data-range="ytd" onclick="setPerfRange('index','ytd',this)">YTD</button>
            </div>
        </div>
        <div class="perf-viewer">
            <div class="chart-container" id="chart-container-perf-index"></div>
        </div>
        <div class="perf-legend" id="perf-legend-index"></div>
        <div class="notes-section">
            <div class="notes-toggle" onclick="toggleNotes('perf-notes-index')">
                <span>📖 ETF 说明（点击展开）</span>
                <span class="toggle-arrow">▼</span>
            </div>
            <div class="notes-content" id="perf-notes-index">
            {% for ticker in ['SPY', 'QQQ', 'IWM', 'DIA', 'RSP'] %}
            {% set note = us_assets_notes.get(ticker) %}
            {% if note %}
                <div class="note-item">
                    <div class="note-title"><span class="note-ticker">{{ ticker }}</span>（{{ note.name }}）：代表"{{ note.represents }}"</div>
                    <div class="note-detail"><strong>跟踪标的：</strong>{{ note.index }}<br><strong>特点：</strong>{{ note.description }}</div>
                </div>
            {% endif %}
            {% endfor %}
            </div>
        </div>
    </div>

    <div class="perf-section">
        <div class="perf-section-header">
            <span class="perf-section-title">US Sector ETFs</span>
            <div class="perf-range-btns" id="perf-range-sector">
                <button class="chart-range-btn active" data-range="6m" onclick="setPerfRange('sector','6m',this)">6M</button>
                <button class="chart-range-btn" data-range="ytd" onclick="setPerfRange('sector','ytd',this)">YTD</button>
            </div>
        </div>
        <div class="perf-viewer">
            <div class="chart-container" id="chart-container-perf-sector"></div>
        </div>
        <div class="perf-legend" id="perf-legend-sector"></div>
        <div class="notes-section">
            <div class="notes-toggle" onclick="toggleNotes('perf-notes-sector')">
                <span>📖 ETF 说明（点击展开）</span>
                <span class="toggle-arrow">▼</span>
            </div>
            <div class="notes-content" id="perf-notes-sector">
            {% for ticker in ['XLC', 'XLY', 'XLP', 'XLE', 'XLF', 'XLV', 'XLI', 'XLB', 'XLRE', 'XLK', 'XLU'] %}
            {% set note = sector_notes.get(ticker) %}
            {% if note %}
                <div class="note-item">
                    <div class="note-title"><span class="note-ticker">{{ ticker }}</span>（{{ note.name }} ETF）：代表"{{ note.represents }}"</div>
                    <div class="note-detail"><strong>追踪指数：</strong>{{ note.index }}<br><strong>特点：</strong>{{ note.description }}</div>
                </div>
            {% endif %}
            {% endfor %}
            </div>
        </div>
    </div>

</div>

{# ── Index Performers Section ── #}
<div class="market-section" id="section-index-performers">
    <div class="perf-section-header">
        <span class="perf-section-title">Index Performers</span>
        <div class="contrib-controls">
            <div class="contrib-btn-group" id="contrib-mode">
                <button type="button" class="chart-range-btn active" onclick="setContribMode('return',this)">Return</button>
                <button type="button" class="chart-range-btn" onclick="setContribMode('weight',this)">Weight</button>
            </div>
            <div class="contrib-btn-group" id="contrib-period">
                <button type="button" class="chart-range-btn active" onclick="setContribPeriod('day',this)">Day</button>
                <button type="button" class="chart-range-btn" onclick="setContribPeriod('week',this)">Week</button>
                <button type="button" class="chart-range-btn" onclick="setContribPeriod('year',this)">Year</button>
            </div>
        </div>
    </div>

    {% macro ip_table(rows, mode) %}
    <table class="contrib-table">
        {% if mode == 'return' %}
        <thead><tr><th>Ticker</th><th>Return</th><th>Week</th><th>Year</th></tr></thead>
        {% else %}
        <thead><tr><th>Ticker</th><th>Weight</th><th>Return</th><th>Contrib</th><th>Week</th><th>W.Contrib</th></tr></thead>
        {% endif %}
        <tbody>
        {% for r in rows %}
            <tr class="contrib-row-data">
                <td class="col-ticker"><a href="{{ r.finviz_url }}" target="_blank" rel="noopener">{{ r.ticker }}</a></td>
                {% if mode == 'return' %}
                    <td data-val="{{ r.day }}">{{ r.day|fmt_pct }}</td>
                    <td data-val="{{ r.week }}">{{ r.week|fmt_pct }}</td>
                    <td data-val="{{ r.year }}">{{ r.year|fmt_pct }}</td>
                {% else %}
                    <td>{{ "%.2f"|format(r.weight * 100) }}%</td>
                    <td data-val="{{ r.day }}">{{ r.day|fmt_pct }}</td>
                    <td data-val="{{ r.day_contrib }}">{{ r.day_contrib|fmt_pct3 }}</td>
                    <td data-val="{{ r.week }}">{{ r.week|fmt_pct }}</td>
                    <td data-val="{{ r.week_contrib }}">{{ r.week_contrib|fmt_pct3 }}</td>
                {% endif %}
            </tr>
        {% endfor %}
        </tbody>
    </table>
    {% endmacro %}

    {% set _ip_has_data = index_performers and index_performers.panels and index_performers.panels[0].cols and index_performers.panels[0].cols[0].top %}
    {% if not _ip_has_data %}
        <div class="ip-empty">Index membership data not yet available — pending Finviz data refresh.</div>
    {% else %}
    {% for panel in index_performers.panels %}
    <div class="contrib-panel" data-period="{{ panel.period }}" data-mode="{{ panel.mode }}"{% if not (panel.period == 'day' and panel.mode == 'return') %} style="display:none;"{% endif %}>
        <div class="contrib-row">
            {% for col in panel.cols %}
            <div class="contrib-column">
                <div class="contrib-column-header">{{ col.index_label }}</div>
                <div class="contrib-table-title top">Top 10 {{ 'Contributors' if panel.mode == 'weight' else 'Performers' }}</div>
                {{ ip_table(col.top, panel.mode) }}
                <div class="contrib-table-title bottom">Bottom 10 {{ 'Contributors' if panel.mode == 'weight' else 'Performers' }}</div>
                {{ ip_table(col.bottom, panel.mode) }}
            </div>
            {% endfor %}
        </div>
    </div>
    {% endfor %}
    {% endif %}
</div>

</div>{# end panel-market-overview #}

</div>{# end content #}

<div class="footer">
    <p>Generated: {{ generated_at_new_york }} | {{ generated_at_beijing }}</p>
    <p>Data source: Finviz, Bloomberg - The Close, CNBC - Closing Bell</p>
    <p>Powered by GuanHe Capital Research Platform</p>
</div>

<script src="https://unpkg.com/lightweight-charts@4.2.0/dist/lightweight-charts.standalone.production.js"></script>
<script>
// ── Embedded chart data (OHLCV daily from EODHD) ──
const CHART_DATA = {{ chart_data_json | safe }};

// ── Ticker display names for chart header ──
const DISPLAY_NAMES = {{ display_names_json | safe }};

// ── Market Temperature card data (daily OHLCV from market_data_eod) ──
const TEMP_CARDS = {{ temperature_json | safe }};
const TEMP_DATA = {};
TEMP_CARDS.forEach(c => { if (c.bars && c.bars.length) TEMP_DATA[c.id] = c.bars; });

// ── Chart state per panel ──
const chartState = {
    'us-assets': { chart: null, candleSeries: null, volSeries: null, maSeries: {}, currentTicker: null, currentRange: '3m', scrollY: 0, maEnabled: {20: true, 50: true, 200: false} },
    'us-sector': { chart: null, candleSeries: null, volSeries: null, maSeries: {}, currentTicker: null, currentRange: '3m', scrollY: 0, maEnabled: {20: true, 50: true, 200: false} },
    'thematic':  { chart: null, candleSeries: null, volSeries: null, maSeries: {}, currentTicker: null, currentRange: '3m', scrollY: 0, maEnabled: {20: true, 50: true, 200: false} },
};

// ── Tab switching ──
function switchTab(tabId) {
    // Update tab buttons
    document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.tab === tabId);
    });
    // Update tab panels
    document.querySelectorAll('.tab-panel').forEach(panel => {
        panel.classList.toggle('active', panel.id === 'panel-' + tabId);
    });
    // Re-render performance charts when switching to Market Overview
    // (Lightweight Charts needs visible container to calculate width)
    if (tabId === 'market-overview') {
        setTimeout(() => {
            renderPerfSection('index');
            renderPerfSection('sector');
            // Resize any open candlestick charts
            Object.keys(chartState).forEach(pid => {
                if (chartState[pid].chart) {
                    const c = document.getElementById('chart-container-' + pid);
                    if (c) chartState[pid].chart.applyOptions({ width: c.clientWidth });
                }
            });
        }, 50);
    }
    // Temperature is the default tab; re-render its cards when returning
    if (tabId === 'temperature') {
        setTimeout(() => renderTempCharts(), 50);
    }
}

// ── Auto-render charts on load ──
window.addEventListener('load', () => {
    // Temperature is the default tab, so its cards render immediately on load.
    // Performance charts render on tab switch to avoid hidden-container sizing issues.
    renderTempCharts();
});

// ── Sortable columns ──
document.querySelectorAll('th[data-col]').forEach(th => {
    th.addEventListener('click', function(e) {
        e.stopPropagation(); // don't trigger row click
        const table = this.closest('table');
        const tbody = table.querySelector('tbody');
        const col = this.dataset.col;
        const type = this.dataset.type;
        const isAsc = this.classList.contains('sorted-asc');

        table.querySelectorAll('th').forEach(h => {
            h.classList.remove('sorted', 'sorted-asc', 'sorted-desc');
            h.querySelector('.sort-arrow').textContent = '▲';
        });

        const rows = Array.from(tbody.querySelectorAll('tr'));
        const colIndex = Array.from(this.closest('tr').children).indexOf(this);

        rows.sort((a, b) => {
            let va = a.children[colIndex].dataset.val || a.children[colIndex].textContent.trim();
            let vb = b.children[colIndex].dataset.val || b.children[colIndex].textContent.trim();
            if (type === 'number') {
                va = parseFloat(va) || 0; vb = parseFloat(vb) || 0;
                return isAsc ? vb - va : va - vb;
            } else {
                return isAsc ? vb.localeCompare(va) : va.localeCompare(vb);
            }
        });
        rows.forEach(r => tbody.appendChild(r));
        this.classList.add('sorted', isAsc ? 'sorted-desc' : 'sorted-asc');
        this.querySelector('.sort-arrow').textContent = isAsc ? '▼' : '▲';
    });
});

// ── Notes toggle ──
function toggleNotes(id) {
    const content = document.getElementById(id);
    const toggle = content.previousElementSibling;
    content.classList.toggle('open');
    toggle.classList.toggle('open');
}

// ── Theme toggle ──
function toggleTheme() {
    const html = document.documentElement;
    const isDark = html.getAttribute('data-theme') === 'dark';
    html.setAttribute('data-theme', isDark ? 'light' : 'dark');
    localStorage.setItem('dmr-theme', isDark ? 'light' : 'dark');
    document.querySelector('.theme-toggle').textContent = isDark ? '☾' : '☀';
    // Re-render any open charts with new theme (skip scroll)
    Object.keys(chartState).forEach(pid => {
        if (chartState[pid].chart && chartState[pid].currentTicker) {
            const ticker = chartState[pid].currentTicker;
            chartState[pid].currentTicker = null; // force re-render
            showChart(pid, ticker, true);
        }
    });
    // Re-render performance charts
    renderPerfSection('index');
    renderPerfSection('sector');
    // Re-render Market Temperature cards
    renderTempCharts();
}

// Restore theme
(function() {
    const saved = localStorage.getItem('dmr-theme');
    if (saved === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
        document.querySelector('.theme-toggle').textContent = '☀';
    }
})();

// ── Chart: get tickers for a panel ──
function getPanelTickers(panelId) {
    const table = document.getElementById('table-' + panelId);
    if (!table) return [];
    return Array.from(table.querySelectorAll('tbody tr.chart-row')).map(tr => tr.dataset.ticker);
}

// ── Chart: filter data by range ──
function filterByRange(data, range) {
    if (!data || !data.length || range === 'all') return data;
    const lastDate = new Date(data[data.length - 1].time);
    let startDate;
    if (range === '1m') {
        startDate = new Date(lastDate); startDate.setMonth(startDate.getMonth() - 1);
    } else if (range === '3m') {
        startDate = new Date(lastDate); startDate.setMonth(startDate.getMonth() - 3);
    } else if (range === '6m') {
        startDate = new Date(lastDate); startDate.setMonth(startDate.getMonth() - 6);
    }
    if (!startDate) return data;
    const startStr = startDate.toISOString().split('T')[0];
    return data.filter(d => d.time >= startStr);
}

// ── Chart: is dark mode ──
function isDarkMode() {
    return document.documentElement.getAttribute('data-theme') === 'dark';
}

// ── Chart: calculate SMA ──
function calcSMA(data, period) {
    const result = [];
    for (let i = period - 1; i < data.length; i++) {
        let sum = 0;
        for (let j = i - period + 1; j <= i; j++) sum += data[j].close;
        result.push({ time: data[i].time, value: sum / period });
    }
    return result;
}

// ── Chart: toggle MA line ──
function toggleMA(panelId, period, btn) {
    const state = chartState[panelId];
    state.maEnabled[period] = !state.maEnabled[period];
    btn.classList.toggle('active', state.maEnabled[period]);

    // If chart is showing, re-render
    if (state.currentTicker) {
        const ticker = state.currentTicker;
        state.currentTicker = null; // prevent toggle
        showChart(panelId, ticker);
    }
}

// ── Chart: show chart for a ticker in a panel ──
function showChart(panelId, ticker, skipScroll) {
    const state = chartState[panelId];
    const viewer = document.getElementById('chart-viewer-' + panelId);
    const container = document.getElementById('chart-container-' + panelId);

    // Toggle: clicking same ticker again closes chart
    if (state.currentTicker === ticker && viewer.style.display !== 'none') {
        closeChart(panelId);
        return;
    }

    const data = CHART_DATA[ticker];
    if (!data || !data.length) {
        // No chart data — show message
        document.getElementById('chart-ticker-' + panelId).textContent = ticker;
        document.getElementById('chart-name-' + panelId).textContent = '— no chart data available';
        viewer.style.display = 'block';
        container.innerHTML = '<div style="padding:40px;text-align:center;color:var(--text-muted)">No historical data for ' + ticker + '</div>';
        if (state.chart) { state.chart = null; state.candleSeries = null; state.volSeries = null; }
        state.currentTicker = ticker;
        highlightRow(panelId, ticker);
        return;
    }

    // Save scroll position before showing viewer
    const isFirstOpen = !state.currentTicker || viewer.style.display === 'none';
    if (isFirstOpen) {
        state.scrollY = window.scrollY;
    }

    const filtered = filterByRange(data, state.currentRange);
    const name = DISPLAY_NAMES[ticker] || ticker;

    // Update header
    document.getElementById('chart-ticker-' + panelId).textContent = ticker;
    document.getElementById('chart-name-' + panelId).textContent = name;

    // Destroy old chart if exists
    if (state.chart) {
        state.chart.remove();
        state.chart = null;
    }
    container.innerHTML = '';

    // Show viewer BEFORE creating chart so container.clientWidth is correct
    viewer.style.display = 'block';

    const dark = isDarkMode();

    // Create chart
    const chart = LightweightCharts.createChart(container, {
        width: container.clientWidth,
        height: 340,
        layout: {
            background: { color: dark ? '#141820' : '#ffffff' },
            textColor: dark ? '#a3adbc' : '#3d4f5f',
            fontSize: 11,
        },
        grid: {
            vertLines: { color: dark ? 'rgba(60,70,90,0.3)' : 'rgba(224,224,224,0.4)' },
            horzLines: { color: dark ? 'rgba(60,70,90,0.3)' : 'rgba(224,224,224,0.4)' },
        },
        crosshair: { mode: 0 }, // Normal
        rightPriceScale: { borderColor: dark ? 'rgba(60,70,90,0.5)' : 'rgba(224,224,224,0.6)' },
        timeScale: {
            borderColor: dark ? 'rgba(60,70,90,0.5)' : 'rgba(224,224,224,0.6)',
            timeVisible: false,
        },
    });

    // Candlestick series
    const candleSeries = chart.addCandlestickSeries({
        upColor: dark ? '#00e676' : '#0a7c42',
        downColor: dark ? '#ff5252' : '#c41230',
        borderUpColor: dark ? '#00e676' : '#0a7c42',
        borderDownColor: dark ? '#ff5252' : '#c41230',
        wickUpColor: dark ? '#00e676' : '#0a7c42',
        wickDownColor: dark ? '#ff5252' : '#c41230',
    });
    candleSeries.setData(filtered);

    // Volume series
    const volSeries = chart.addHistogramSeries({
        priceFormat: { type: 'volume' },
        priceScaleId: 'vol',
        color: dark ? '#334155' : '#c8d6e0',
    });
    chart.priceScale('vol').applyOptions({
        scaleMargins: { top: 0.8, bottom: 0 },
    });
    const volData = filtered.map(d => ({
        time: d.time,
        value: d.volume,
        color: d.close >= d.open
            ? (dark ? 'rgba(0,230,118,0.25)' : 'rgba(10,124,66,0.2)')
            : (dark ? 'rgba(255,82,82,0.25)' : 'rgba(196,18,48,0.2)'),
    }));
    volSeries.setData(volData);

    // Moving average lines — compute from ALL data for accuracy
    const maColors = { 20: '#f59e0b', 50: '#3b82f6', 200: '#a855f7' };
    state.maSeries = {};
    [20, 50, 200].forEach(period => {
        if (!state.maEnabled[period]) return;
        const maFull = calcSMA(data, period); // calc from full dataset
        const maFiltered = filterByRange(maFull, state.currentRange);
        if (!maFiltered.length) return;
        const maSeries = chart.addLineSeries({
            color: maColors[period],
            lineWidth: 1,
            priceLineVisible: false,
            lastValueVisible: false,
            crosshairMarkerVisible: false,
        });
        maSeries.setData(maFiltered);
        state.maSeries[period] = maSeries;
    });

    chart.timeScale().fitContent();
    state.chart = chart;
    state.candleSeries = candleSeries;
    state.volSeries = volSeries;
    state.currentTicker = ticker;

    // Scroll: only on first open, skip during theme toggle or arrow nav
    if (isFirstOpen && !skipScroll) {
        viewer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    } else {
        window.scrollTo(0, state.scrollY);
    }

    highlightRow(panelId, ticker);
}

// ── Chart: close chart ──
function closeChart(panelId) {
    const state = chartState[panelId];
    const viewer = document.getElementById('chart-viewer-' + panelId);
    if (state.chart) {
        state.chart.remove();
        state.chart = null;
        state.candleSeries = null;
        state.volSeries = null;
    }
    viewer.style.display = 'none';
    state.currentTicker = null;
    state.scrollY = 0;
    highlightRow(panelId, null);
}

// ── Chart: set time range ──
function setChartRange(panelId, range, btn) {
    const state = chartState[panelId];
    state.currentRange = range;

    // Update button active state
    const viewer = document.getElementById('chart-viewer-' + panelId);
    viewer.querySelectorAll('.chart-range-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    // Re-render if ticker is showing
    if (state.currentTicker) {
        const ticker = state.currentTicker;
        state.currentTicker = null; // force re-render (not toggle)
        showChart(panelId, ticker);
    }
}

// ── Chart: highlight active row ──
function highlightRow(panelId, ticker) {
    const table = document.getElementById('table-' + panelId);
    if (!table) return;
    table.querySelectorAll('tbody tr.chart-row').forEach(tr => {
        tr.classList.toggle('chart-active', tr.dataset.ticker === ticker);
    });
}

// ── Row click handlers ──
document.querySelectorAll('tbody tr.chart-row').forEach(tr => {
    tr.addEventListener('click', function(e) {
        // Don't trigger if clicking a th (sort)
        if (e.target.closest('th')) return;
        const ticker = this.dataset.ticker;
        const table = this.closest('table');
        const panelId = table.id.replace('table-', '');
        showChart(panelId, ticker);
    });
});

// ── Keyboard navigation ──
document.addEventListener('keydown', function(e) {
    // Find the active panel
    let activePanel = null;
    Object.keys(chartState).forEach(pid => {
        if (chartState[pid].currentTicker) activePanel = pid;
    });
    if (!activePanel) return;

    const state = chartState[activePanel];

    if (e.key === 'Escape') {
        e.preventDefault();
        closeChart(activePanel);
        return;
    }

    if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
        e.preventDefault();
        const tickers = getPanelTickers(activePanel);
        const idx = tickers.indexOf(state.currentTicker);
        if (idx === -1) return;
        let newIdx;
        if (e.key === 'ArrowLeft') {
            newIdx = idx > 0 ? idx - 1 : tickers.length - 1;
        } else {
            newIdx = idx < tickers.length - 1 ? idx + 1 : 0;
        }
        state.currentTicker = null; // prevent toggle
        showChart(activePanel, tickers[newIdx]);
    }
});

// ── Resize handler ──
window.addEventListener('resize', function() {
    Object.keys(chartState).forEach(pid => {
        const state = chartState[pid];
        if (state.chart) {
            const container = document.getElementById('chart-container-' + pid);
            state.chart.applyOptions({ width: container.clientWidth });
        }
    });
    ['index', 'sector'].forEach(g => {
        if (perfCharts[g]) {
            const c = document.getElementById('chart-container-perf-' + g);
            if (c) perfCharts[g].chart.applyOptions({ width: c.clientWidth });
        }
    });
    Object.keys(tempCharts).forEach(id => {
        const c = document.getElementById('mt-chart-' + id);
        if (c && tempCharts[id]) tempCharts[id].applyOptions({ width: c.clientWidth });
    });
});

// ═══════════════════════════════════════════════
// ── MARKET TEMPERATURE ──
// ═══════════════════════════════════════════════

// Chart instances per card id
const tempCharts = {};
let tempRange = '3m';

function tempFilterByRange(data, range) {
    if (!data || !data.length) return data;
    const lastDate = new Date(data[data.length - 1].time);
    let startDate;
    if (range === '3m') {
        startDate = new Date(lastDate); startDate.setMonth(startDate.getMonth() - 3);
    } else if (range === '6m') {
        startDate = new Date(lastDate); startDate.setMonth(startDate.getMonth() - 6);
    } else if (range === '1y') {
        startDate = new Date(lastDate); startDate.setFullYear(startDate.getFullYear() - 1);
    }
    if (!startDate) return data;
    return data.filter(d => d.time >= startDate.toISOString().split('T')[0]);
}

function renderTempCharts() {
    const panel = document.getElementById('panel-temperature');
    if (!panel || !panel.classList.contains('active')) return;

    const dark = isDarkMode();

    Object.keys(tempCharts).forEach(id => {
        if (tempCharts[id]) { tempCharts[id].remove(); tempCharts[id] = null; }
    });

    document.querySelectorAll('#panel-temperature .mt-chart:not(.mt-chart-empty)').forEach(el => {
        const id = el.id.replace('mt-chart-', '');
        const bars = TEMP_DATA[id];
        if (!bars || !bars.length) return;

        const chart = LightweightCharts.createChart(el, {
            width: el.clientWidth,
            height: 160,
            layout: {
                background: { color: 'transparent' },
                textColor: dark ? '#a3adbc' : '#3d4f5f',
                fontSize: 9,
                attributionLogo: false,
            },
            grid: {
                vertLines: { visible: false },
                horzLines: { color: dark ? 'rgba(60,70,90,0.25)' : 'rgba(224,224,224,0.35)' },
            },
            crosshair: { mode: 0 },
            rightPriceScale: {
                borderVisible: false,
                scaleMargins: { top: 0.08, bottom: 0.08 },
            },
            timeScale: { borderVisible: false, timeVisible: false },
            handleScale: false,
            handleScroll: false,
        });

        const visible = tempFilterByRange(bars, tempRange);

        // Candlestick series (colors match the Market Movers viewer)
        const series = chart.addCandlestickSeries({
            upColor: dark ? '#00e676' : '#0a7c42',
            downColor: dark ? '#ff5252' : '#c41230',
            borderUpColor: dark ? '#00e676' : '#0a7c42',
            borderDownColor: dark ? '#ff5252' : '#c41230',
            wickUpColor: dark ? '#00e676' : '#0a7c42',
            wickDownColor: dark ? '#ff5252' : '#c41230',
        });
        series.setData(visible);
        chart.timeScale().fitContent();
        tempCharts[id] = chart;
    });
}

function setTempRange(range, btn) {
    tempRange = range;
    document.querySelectorAll('#mt-range .chart-range-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    renderTempCharts();
}

// ═══════════════════════════════════════════════
// ── PERFORMANCE CHARTS ──
// ═══════════════════════════════════════════════

const PERF_TICKERS = {
    index:  ['SPY', 'QQQ', 'IWM', 'DIA', 'RSP'],
    sector: ['XLC', 'XLY', 'XLP', 'XLE', 'XLF', 'XLV', 'XLI', 'XLB', 'XLRE', 'XLK', 'XLU'],
};

const PERF_COLORS = {
    index:  ['#3b82f6', '#ef4444', '#22c55e', '#f59e0b', '#a855f7'],
    sector: ['#ec4899', '#14b8a6', '#f97316', '#6366f1', '#84cc16',
             '#06b6d4', '#e11d48', '#65a30d', '#d97706', '#7c3aed', '#db2777'],
};

// Per-section state
const perfCharts = { index: null, sector: null };

function perfFilterByRange(data, range) {
    if (!data || !data.length) return data;
    const lastDate = new Date(data[data.length - 1].time);
    let startDate;
    if (range === '6m') {
        startDate = new Date(lastDate); startDate.setMonth(startDate.getMonth() - 6);
    } else if (range === 'ytd') {
        startDate = new Date(lastDate.getFullYear(), 0, 1);
    }
    if (!startDate) return data;
    return data.filter(d => d.time >= startDate.toISOString().split('T')[0]);
}

function normalizePerformance(ticker, range) {
    const data = CHART_DATA[ticker];
    if (!data || !data.length) return null;
    const filtered = perfFilterByRange(data, range);
    if (!filtered.length) return null;
    const baseClose = filtered[0].close;
    if (!baseClose) return null;
    return filtered.map(d => ({
        time: d.time,
        value: ((d.close / baseClose) - 1) * 100,
    }));
}

function renderPerfSection(group) {
    const container = document.getElementById('chart-container-perf-' + group);
    if (!container) return;

    if (!perfCharts[group]) {
        perfCharts[group] = { chart: null, series: {}, hidden: new Set(), range: '6m' };
    }
    const state = perfCharts[group];

    if (state.chart) { state.chart.remove(); state.chart = null; }
    container.innerHTML = '';
    state.series = {};

    const tickers = PERF_TICKERS[group];
    const colors = PERF_COLORS[group];
    const dark = isDarkMode();

    const normData = [];
    tickers.forEach((t, i) => {
        const norm = normalizePerformance(t, state.range);
        if (norm && norm.length) normData.push({ ticker: t, data: norm, color: colors[i] });
    });

    if (!normData.length) {
        container.innerHTML = '<div style="padding:60px;text-align:center;color:var(--text-muted)">No chart data available</div>';
        buildPerfLegend(group, tickers, colors, []);
        return;
    }

    const chart = LightweightCharts.createChart(container, {
        width: container.clientWidth,
        height: 350,
        layout: {
            background: { color: dark ? '#141820' : '#ffffff' },
            textColor: dark ? '#a3adbc' : '#3d4f5f',
            fontSize: 11,
        },
        grid: {
            vertLines: { color: dark ? 'rgba(60,70,90,0.3)' : 'rgba(224,224,224,0.4)' },
            horzLines: { color: dark ? 'rgba(60,70,90,0.3)' : 'rgba(224,224,224,0.4)' },
        },
        crosshair: { mode: 0 },
        rightPriceScale: {
            borderColor: dark ? 'rgba(60,70,90,0.5)' : 'rgba(224,224,224,0.6)',
            scaleMargins: { top: 0.05, bottom: 0.05 },
        },
        timeScale: {
            borderColor: dark ? 'rgba(60,70,90,0.5)' : 'rgba(224,224,224,0.6)',
            timeVisible: false,
        },
    });

    normData.forEach(({ ticker, data, color }) => {
        const isHidden = state.hidden.has(ticker);
        const series = chart.addLineSeries({
            color: isHidden ? 'transparent' : color,
            lineWidth: 2,
            priceLineVisible: false,
            lastValueVisible: false,
            crosshairMarkerVisible: !isHidden,
            title: ticker,
        });
        series.setData(data);
        state.series[ticker] = series;
    });

    chart.timeScale().fitContent();
    state.chart = chart;

    buildPerfLegend(group, tickers, colors, normData);
}

function buildPerfLegend(group, tickers, colors, normDataArr) {
    const legend = document.getElementById('perf-legend-' + group);
    if (!legend) return;
    const state = perfCharts[group];

    legend.innerHTML = '';
    tickers.forEach((t, i) => {
        const color = colors[i];
        const isHidden = state.hidden.has(t);
        const name = DISPLAY_NAMES[t] || '';

        let pctStr = '';
        if (normDataArr) {
            const entry = normDataArr.find(e => e.ticker === t);
            if (entry && entry.data.length) {
                const lastVal = entry.data[entry.data.length - 1].value;
                pctStr = (lastVal >= 0 ? '+' : '') + lastVal.toFixed(1) + '%';
            }
        }

        const item = document.createElement('div');
        item.className = 'perf-legend-item' + (isHidden ? ' hidden' : '');
        item.innerHTML = '<span class="perf-dot" style="background:' + color + '"></span>' +
            '<span class="perf-ticker">' + t + '</span>' +
            (name ? '<span class="perf-name">' + name + '</span>' : '') +
            (pctStr ? '<span class="perf-pct" style="color:' + (isHidden ? '' : color) + '">' + pctStr + '</span>' : '');
        item.onclick = () => togglePerfLegendItem(group, t);
        legend.appendChild(item);
    });
}

function togglePerfLegendItem(group, ticker) {
    const state = perfCharts[group];
    if (!state) return;

    if (state.hidden.has(ticker)) {
        state.hidden.delete(ticker);
    } else {
        state.hidden.add(ticker);
    }

    const series = state.series[ticker];
    const colors = PERF_COLORS[group];
    const tickers = PERF_TICKERS[group];
    const i = tickers.indexOf(ticker);
    const color = i >= 0 ? colors[i] : '#888';

    if (series) {
        const isHidden = state.hidden.has(ticker);
        series.applyOptions({
            color: isHidden ? 'transparent' : color,
            crosshairMarkerVisible: !isHidden,
        });
    }

    const normData = [];
    tickers.forEach((t, ti) => {
        const norm = normalizePerformance(t, state.range);
        if (norm && norm.length) normData.push({ ticker: t, data: norm, color: colors[ti] });
    });
    buildPerfLegend(group, tickers, colors, normData);
}

function setPerfRange(group, range, btn) {
    if (!perfCharts[group]) {
        perfCharts[group] = { chart: null, series: {}, hidden: new Set(), range: '6m' };
    }
    perfCharts[group].range = range;

    document.querySelectorAll('#perf-range-' + group + ' .chart-range-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    renderPerfSection(group);
}

// === Index Performers toggles ===
const contribState = { period: 'day', mode: 'return' };

function setContribMode(mode, btn) {
    contribState.mode = mode;
    document.querySelectorAll('#contrib-mode .chart-range-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    renderContrib();
}
function setContribPeriod(period, btn) {
    contribState.period = period;
    document.querySelectorAll('#contrib-period .chart-range-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    renderContrib();
}
function renderContrib() {
    const section = document.getElementById('section-index-performers');
    if (!section) return;
    section.querySelectorAll('.contrib-panel').forEach(p => {
        const show = (p.dataset.period === contribState.period && p.dataset.mode === contribState.mode);
        p.style.display = show ? '' : 'none';
    });
}
// 初始化：使默认 panel 显隐一致（Top 10 / Bottom 10 全部默认显示）
renderContrib();

</script>

</body>
</html>

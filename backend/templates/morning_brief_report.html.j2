<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Morning Brief — {{ report_date }}</title>
<style>
  :root { color-scheme: light dark; }
  body { font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
         margin: 0; background: #f6f7f9; color: #1f2329; }
  .wrap { max-width: 920px; margin: 0 auto; padding: 24px 20px 60px; }
  header { padding: 14px 20px; margin-bottom: 20px;
           position: sticky; top: 12px;
           background: linear-gradient(180deg, #1b4b7d 0%, #1d5998 100%);
           color: #fff; border-radius: 10px;
           box-shadow: 0 2px 10px rgba(27, 75, 125, .35); }
  h1 { font-size: 22px; margin: 0 0 6px; color: #fff; }
  .meta { font-size: 12px; color: rgba(255, 255, 255, .78); line-height: 1.8; }
  .hdr { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .gh-brand { display: flex; align-items: center; gap: 10px; padding-right: 14px;
              border-right: 1px solid rgba(255, 255, 255, .18); }
  .gh-brand .seal { position: relative; width: 38px; height: 38px; border-radius: 50%;
              display: flex; align-items: center; justify-content: center;
              font: 600 16px/1 Georgia, 'Songti SC', 'STSong', 'SimSun', 'Noto Serif TC', serif;
              color: #e9d6a4; border: 1px solid rgba(216, 188, 126, .85); }
  .gh-brand .seal::before { content: ''; position: absolute; inset: 3px; border-radius: 50%;
              border: 1px solid rgba(216, 188, 126, .35); }
  .gh-brand .name { display: flex; flex-direction: column; line-height: 1.2; }
  .gh-brand .zh { font: 600 17px/1.2 Georgia, 'Songti SC', 'STSong', 'SimSun', 'Noto Serif TC', serif;
              color: #e9d6a4; letter-spacing: .14em; }
  .gh-brand .en { font: 600 8.5px/1 Georgia, 'Times New Roman', serif; color: rgba(255, 255, 255, .55);
              letter-spacing: .42em; text-indent: .42em; margin-top: 4px; white-space: nowrap; }
  main { background: #fff; border-radius: 8px; padding: 24px 28px;
         box-shadow: 0 1px 3px rgba(0,0,0,.06); }
  main h2 { border-left: 4px solid #1b4b7d; padding-left: 10px; font-size: 18px;
            color: #1b4b7d; }
  table { border-collapse: collapse; width: 100%; font-size: 13px; margin: 10px 0; }
  th, td { border: 1px solid #e0e3e8; padding: 6px 10px; text-align: left; }
  th { background: #1b4b7d; color: #fff; }
  a { color: #3370ff; }
  @media (prefers-color-scheme: dark) {
    body { background: #111417; color: #e8eaed; }
    main { background: #1b1f24; box-shadow: none; }
    th { background: #1b4b7d; }
    main h2 { color: #9db8d8; border-left-color: #1d5998; }
    th, td { border-color: #3a4048; }
    .meta { color: #9aa4b2; }
  }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="hdr">
      <div>
        <h1>Morning Brief（facts-report）</h1>
        <div class="meta">
          报告日期 {{ report_date }} · 美股交易日 {{ session_date }}<br>
          生成于 {{ generated_at_beijing }} / {{ generated_at_new_york }} / {{ generated_at_utc }}<br>
          工作区 {{ workspace }}
        </div>
      </div>
      <div class="gh-brand" aria-label="觀合資本 GuanHe Capital"><span class="name"><span class="zh">觀合資本</span><span class="en">GUANHE CAPITAL</span></span></div>
    </div>
  </header>
  <main>{{ summary_html }}</main>
</div>
</body>
</html>

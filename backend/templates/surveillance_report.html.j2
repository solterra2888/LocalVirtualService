<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bloomberg Surveillance Report - {{ report_date }}</title>
<style>
/* === RESET & BASE（视觉语言对齐 daily_market_report.html.j2） === */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
    --bg-page: #ffffff;
    --bg-card: #ffffff;
    --bg-header: linear-gradient(90deg, #2d4a6f 0%, #1e3a5f 100%);
    --bg-hover: #f0f4f8;
    --text-primary: #111111;
    --text-secondary: #3d4f5f;
    --text-muted: #6b7a8a;
    --text-header: #ffffff;
    --border: rgba(224, 224, 224, 0.6);
    --border-subtle: #e8ecf1;
    --shadow-card: 0 2px 12px rgba(0,0,0,0.06);
}

[data-theme="dark"] {
    --bg-page: #0B0E14;
    --bg-card: #141820;
    --bg-header: linear-gradient(90deg, #1a2235 0%, #141820 100%);
    --bg-hover: #1e2536;
    --text-primary: #edf0f4;
    --text-secondary: #a3adbc;
    --text-muted: #727f92;
    --text-header: #edf0f4;
    --border: rgba(60, 70, 90, 0.5);
    --border-subtle: rgba(60, 70, 90, 0.3);
    --shadow-card: 0 2px 16px rgba(0,0,0,0.3);
}

html { font-size: 15px; }
body {
    font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', Roboto, sans-serif;
    background: var(--bg-page);
    color: var(--text-primary);
    line-height: 1.5;
    min-height: 100vh;
}

/* === HEADER === */
.report-header {
    background: var(--bg-header);
    padding: 20px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
}
.report-header h1 {
    color: var(--text-header);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.01em;
}
.report-header-right {
    display: flex;
    align-items: center;
    gap: 16px;
    color: var(--text-header);
    font-size: 0.85rem;
    opacity: 0.8;
}
.theme-toggle {
    background: rgba(255,255,255,0.15);
    border: none;
    color: white;
    padding: 4px 10px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 1rem;
}

/* === VIDEO META BAR === */
.meta-bar {
    max-width: 900px;
    margin: 24px auto 0;
    padding: 0 28px;
}
.meta-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    box-shadow: var(--shadow-card);
    padding: 16px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
}
.meta-source {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    white-space: nowrap;
}
.meta-title {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    overflow-wrap: break-word;
}
a.meta-title:hover { text-decoration: underline; }
.meta-title.is-static { cursor: default; }
.meta-title.is-static:hover { text-decoration: none; }
.meta-words {
    font-size: 0.8rem;
    color: var(--text-muted);
    white-space: nowrap;
}

/* === CONTENT（渲染自 Markdown 的摘要正文） === */
.content { max-width: 900px; margin: 0 auto; padding: 20px 28px 32px; }

.summary-content {
    background: var(--bg-card);
    border-radius: 8px;
    box-shadow: var(--shadow-card);
    padding: 28px 32px;
    line-height: 1.75;
    color: var(--text-primary);
    font-size: 0.9rem;
}
.summary-content h1 {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 24px 0 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border-subtle);
}
.summary-content h1:first-child { margin-top: 0; }
.summary-content h2 {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 20px 0 10px;
}
.summary-content h3 {
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin: 16px 0 8px;
}
.summary-content p {
    margin: 8px 0;
    color: var(--text-secondary);
}
.summary-content ul, .summary-content ol {
    margin: 8px 0;
    padding-left: 24px;
    color: var(--text-secondary);
}
.summary-content li { margin: 4px 0; }
.summary-content strong {
    color: var(--text-primary);
    font-weight: 600;
}
.summary-content blockquote {
    border-left: 3px solid var(--border);
    margin: 12px 0;
    padding: 8px 16px;
    color: var(--text-muted);
    font-style: italic;
}
.summary-content table {
    margin: 12px 0;
    font-size: 13px;
    table-layout: auto;
    border-collapse: collapse;
    width: 100%;
}
.summary-content th, .summary-content td {
    padding: 8px 12px;
    text-align: left;
    vertical-align: top;
    white-space: normal;
    overflow-wrap: break-word;
    border-bottom: 1px solid var(--border-subtle);
}
.summary-content th {
    white-space: nowrap;
    color: var(--text-muted);
    font-weight: 600;
    background: var(--bg-hover);
}
.summary-content code {
    font-family: 'SF Mono', 'Fira Code', 'Consolas', monospace;
    background: var(--bg-hover);
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 0.88em;
}
.summary-content hr {
    border: none;
    border-top: 1px solid var(--border-subtle);
    margin: 20px 0;
}
.summary-content a { color: inherit; }

/* === FOOTER === */
.footer {
    text-align: center;
    padding: 16px 0 28px;
    font-size: 0.78rem;
    color: var(--text-muted);
}

@media (max-width: 768px) {
    .report-header, .meta-bar, .content { padding-left: 16px; padding-right: 16px; }
    .summary-content { padding: 20px 18px; }
    .summary-content table { font-size: 12px; }
}
</style>
</head>
<body>

<div class="report-header">
    <h1>Bloomberg Surveillance Report</h1>
    <div class="report-header-right">
        <span>{{ report_date }}</span>
        <button class="theme-toggle" onclick="toggleTheme()">&#9790;</button>
    </div>
</div>

<div class="meta-bar">
    <div class="meta-card">
        <span class="meta-source">Bloomberg &middot; Surveillance</span>
        {% if video_url %}
        <a class="meta-title" href="{{ video_url }}" target="_blank" rel="noopener noreferrer" title="Open episode on YouTube">{{ video_title or 'Episode' }}</a>
        {% else %}
        <span class="meta-title is-static">{{ video_title or 'Episode' }}</span>
        {% endif %}
        <span class="meta-words">{% if video_count and video_count > 1 %}{{ video_count }} episodes &middot; {% endif %}{% if transcript_word_count %}{{ '{:,}'.format(transcript_word_count) }} words transcript{% endif %}</span>
    </div>
</div>

<div class="content">
    <div class="summary-content">
        {{ summary_html }}
    </div>
    <div class="footer">
        <p>Generated: {{ generated_at_new_york }} | {{ generated_at_beijing }}</p>
    </div>
</div>

<script>
// ── Theme toggle（与 DMR / The Close / Closing Bell Report 相互独立的 localStorage key） ──
function toggleTheme() {
    const html = document.documentElement;
    const isDark = html.getAttribute('data-theme') === 'dark';
    html.setAttribute('data-theme', isDark ? 'light' : 'dark');
    localStorage.setItem('surveillance-theme', isDark ? 'light' : 'dark');
    document.querySelector('.theme-toggle').textContent = isDark ? '☾' : '☀';
}

(function() {
    const saved = localStorage.getItem('surveillance-theme');
    if (saved === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
        document.querySelector('.theme-toggle').textContent = '☀';
    }
})();
</script>

</body>
</html>

{
  "manifest_version": 3,
  "name": "GuanHe Web Clipper",
  "version": "1.0",
  "description": "Capture web pages and save to GuanHe platform with embedded images",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    },
    "default_title": "GuanHe Web Clipper",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}

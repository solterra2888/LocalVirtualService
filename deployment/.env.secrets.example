# ===========================================
# 敏感密钥配置（每台服务器不同，禁止提交 git）
# 复制为 .env.secrets 并填入实际密钥
# ===========================================

# 数据库密码
DB_PASSWORD=

# 默认管理员密码
DEFAULT_ADMIN_PASSWORD=

# JWT 认证密钥（运行 python3 -c "import secrets; print(secrets.token_urlsafe(48))" 生成）
JWT_SECRET_KEY=

# Redis 密码（无密码则留空）
REDIS_PASSWORD=

# LlamaIndex Cloud API 密钥
LLAMA_CLOUD_API_KEY=

# EODHD 市场数据 API 密钥
EODHD_API_TOKEN=

# Twitter/X API 密钥
TWITTER_API_KEY=

# 阿里云通义千问 API 密钥
DASHSCOPE_API_KEY=

# 阿里云 OSS
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# RC Agent 令牌
RC_AGENT_TOKEN=

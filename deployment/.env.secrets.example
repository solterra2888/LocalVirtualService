# ===========================================
# 敏感密钥配置（每台服务器不同，禁止提交 git）
# 复制为 .env.secrets 并填入实际密钥
# ===========================================

# 数据库密码
DB_PASSWORD=your_db_password_here

# 默认管理员密码
DEFAULT_ADMIN_PASSWORD=your_admin_password_here

# JWT 认证密钥（运行 python3 -c "import secrets; print(secrets.token_urlsafe(48))" 生成）
JWT_SECRET_KEY=your_jwt_secret_key_here

# Redis 密码（本地无密码 Redis 必须留空，否则上传文件/音频会报 AUTH ... without any password configured）
REDIS_PASSWORD=your_redis_password_here

# LlamaIndex Cloud API 密钥
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key_here

# EODHD 市场数据 API 密钥
EODHD_API_TOKEN=your_eodhd_api_token_here

# Twitter/X API 密钥
TWITTER_API_KEY=your_twitter_api_key_here

# 阿里云通义千问 API 密钥
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 阿里云 OSS
OSS_ACCESS_KEY_ID=your_oss_access_key_id_here
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret_here
# 若 OSS 为私有桶且 Fun-ASR 报 FILE_DOWNLOAD_FAILED，取消下行注释
# OSS_ASR_PUBLIC_READ=true

# RC Agent 令牌
RC_AGENT_TOKEN=your_rc_agent_token_here

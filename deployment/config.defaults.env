# ===========================================
# 应用默认参数（所有服务器通用，提交 git）
# 一般不需要修改，除非要调优
# ===========================================

# ===== 默认管理员 =====
DEFAULT_ADMIN_USER=admin

# ===== 部署模式 =====
DEPLOYMENT_MODE=unified
# 生产环境设为 production，避免后端将 PDF/图片预览 URL 改写为 localhost（导致远程访问时 iframe 报 refused to connect）
ENV=production
# Swagger/ReDoc：ENV=production 时默认不挂载 /api/docs（减少公网接口侦察）。需要时在服务器 .env 单独写 ENABLE_API_DOCS=true

# ===== 日志 =====
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_TO_CONSOLE=true
LOG_FILE_DAYS=30

# ===== EODHD 性能 =====
EODHD_BATCH_SIZE=2000
EODHD_REQUEST_DELAY=0.01
EODHD_ENABLE_FULL_PROCESSING=true
EODHD_ENABLE_RATE_LIMIT_MONITORING=true
EODHD_MAX_RETRIES_ON_RATE_LIMIT=3
EODHD_RATE_LIMIT_BACKOFF_FACTOR=2
EODHD_TURBO_MODE=false
EODHD_MAX_WORKERS=50

# ===== Twitter 订阅 =====
TWITTER_DEFAULT_QUERY_HOURS=24
# 增量任务最小回看窗口（小时）；过小可能漏索引延迟推文，过大则 API 调用量与 Celery 耗时上升
TWITTER_MIN_LOOKBACK_HOURS=6
TWITTER_INITIAL_FETCH_HOURS=168
TWITTER_MAX_TWEETS_PER_REQUEST=20

# ===== RC Agent 默认名称 =====
RC_AGENT_NAME_default=默认任务

# ===== 前端 =====
REACT_APP_API_BASE_URL=/api
REACT_APP_SCHEDULER_BASE_URL=/scheduler

# ===== OSS 存储路径（香港 Bucket: guanhetech-hk）=====
OSS_BUCKET_NAME=guanhetech-hk
OSS_ENDPOINT=oss-cn-hongkong.aliyuncs.com
OSS_AUDIO_PREFIX=audio/
OSS_DOCUMENT_PREFIX=documents/
OSS_IMAGE_PREFIX=images/
OSS_WEB_CLIP_PREFIX=web-clips/
OSS_TEMP_PREFIX=temp/
# 若 OSS 为私有桶且 Fun-ASR 报 FILE_DOWNLOAD_FAILED，在 deployment/.env.secrets 中增加一行 OSS_ASR_PUBLIC_READ=true，然后重新运行 deploy.sh
OSS_ASR_PUBLIC_READ=false

# ===== 自动打标签 =====
AUTO_TAG_ENABLED=true
AUTO_TAG_DELAY=2
AUTO_TAG_MIN_CONTENT_LENGTH=100
AUTO_TAG_CONTENT_MAX_CHARS=6000

# ===== 自动向量化（OSS Vector Bucket / 语义检索）=====
# 与 AUTO_TAG_* / AUTO_ANALYZE_* 并列的第 5 路并行任务。处理上传文档与订阅 Feed 的语义索引。
AUTO_VECTORIZE_ENABLED=true
AUTO_VECTORIZE_DELAY=2
# 长度门槛：< MIN 自动跳过（短文全文已可入 prompt），>= FORCE_LONG 强制向量化（超过 Agent _MAX_CONTENT_CHARS=32000）
AUTO_VECTORIZE_MIN_CONTENT_LENGTH=3000
AUTO_VECTORIZE_FORCE_LONG_THRESHOLD=32000
# 超大保护：超过此长度暂不自动向量化，等待人工确认（避免百万字超长文档一次烧光配额）
AUTO_VECTORIZE_MAX_CONTENT_LENGTH=10000000
# 分块参数（中文字符为单位；英文按 token 大致 1 char ≈ 0.3-0.5 token）
CHUNK_TARGET_CHARS=600
CHUNK_OVERLAP_CHARS=80
# Vector Bucket 配置（生产 .env 覆盖；OSS_VECTOR_BUCKET 留空则跳过初始化）
OSS_VECTOR_BUCKET=
OSS_VECTOR_REGION=cn-hongkong
OSS_VECTOR_ACCOUNT_ID=
OSS_VECTOR_ENDPOINT=
OSS_VECTOR_INDEX=contentchunks
# Twitter 短推智能路由：开启后 <250 字且无 $cashtag 走 tweet_signal_v1，否则走 content_tag_feeds_v1
TWEET_SIGNAL_V1_ENABLED=true
# 重型模板字符阈值（超过此值或含 $TICKER 走 content_tag_feeds_v1）
TWEET_SIGNAL_HEAVY_THRESHOLD_CHARS=250
# 覆盖 tweet_signal_v1 推荐模型（留空使用模板默认 qwen3-plus）
TWEET_SIGNAL_MODEL_OVERRIDE=

# ===== Celery =====
CELERY_CONCURRENCY=4

# ===== 文件处理 / 分析（ASR、LlamaParse 轮询、LLM 单次请求读超时上限）=====
# 单阶段最长等待（分钟）。超时后本地停止等待并返回超时错误；不保证云端任务已取消。
FILE_PROCESSING_TIMEOUT_MINUTES=5

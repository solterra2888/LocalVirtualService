# ===========================================
# 应用默认参数（所有服务器通用，提交 git）
# 一般不需要修改，除非要调优
# ===========================================

# ===== 默认管理员 =====
DEFAULT_ADMIN_USER=admin

# ===== 部署模式 =====
DEPLOYMENT_MODE=unified
# 生产环境设为 production，避免后端将 PDF/图片预览 URL 改写为 localhost（导致远程访问时 iframe 报 refused to connect）
ENV=production
# Swagger/ReDoc：ENV=production 时默认不挂载 /api/docs（减少公网接口侦察）。需要时在服务器 .env 单独写 ENABLE_API_DOCS=true

# ===== 日志 =====
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_TO_CONSOLE=true
LOG_FILE_DAYS=30
LOG_ASYNC=true

# ===== EODHD 性能 =====
EODHD_BATCH_SIZE=2000
EODHD_REQUEST_DELAY=0.01
EODHD_ENABLE_FULL_PROCESSING=true
EODHD_ENABLE_RATE_LIMIT_MONITORING=true
EODHD_MAX_RETRIES_ON_RATE_LIMIT=3
EODHD_RATE_LIMIT_BACKOFF_FACTOR=2
EODHD_TURBO_MODE=false
EODHD_MAX_WORKERS=50

# ===== Twitter 订阅 =====
TWITTER_DEFAULT_QUERY_HOURS=24
# 增量任务最小回看窗口（小时）；过小可能漏索引延迟推文，过大则 API 调用量与 Celery 耗时上升
TWITTER_MIN_LOOKBACK_HOURS=6
TWITTER_INITIAL_FETCH_HOURS=168
TWITTER_MAX_TWEETS_PER_REQUEST=20

# ===== RC Agent 默认名称 =====
RC_AGENT_NAME_default=默认任务

# ===== 前端 =====
REACT_APP_API_BASE_URL=/api
REACT_APP_SCHEDULER_BASE_URL=/scheduler

# ===== OSS 存储路径（香港 Bucket: guanhetech-hk）=====
OSS_BUCKET_NAME=guanhetech-hk
OSS_ENDPOINT=oss-cn-hongkong.aliyuncs.com
OSS_AUDIO_PREFIX=audio/
OSS_DOCUMENT_PREFIX=documents/
OSS_IMAGE_PREFIX=images/
OSS_WEB_CLIP_PREFIX=web-clips/
OSS_TEMP_PREFIX=temp/
# 若 OSS 为私有桶且 Fun-ASR 报 FILE_DOWNLOAD_FAILED，在 deployment/.env.secrets 中增加一行 OSS_ASR_PUBLIC_READ=true，然后重新运行 deploy.sh
OSS_ASR_PUBLIC_READ=false

# ===== 自动打标签 =====
AUTO_TAG_ENABLED=true
AUTO_TAG_DELAY=2
AUTO_TAG_MIN_CONTENT_LENGTH=100
AUTO_TAG_CONTENT_MAX_CHARS=6000

# ===== Web Clip (Chrome Extension 快剪藏) =====
# clip 入库只自动打标/命名/归类，不触发 AI 分析（默认 false；改 true 恢复自动分析）
WEB_CLIP_AUTO_ANALYZE_ENABLED=false

# ===== Feeds 自动打标（Twitter / YouTube / Podcast / News / 知识星球 / 微博 / Substack）=====
# Twitter 短推、YouTube/Podcast 字幕、News、知识星球、微博、Substack 入库后自动派发打标任务
AUTO_FEED_TAG_ENABLED=true
AUTO_FEED_TAG_CHANNELS=twitter,youtube,podcast,news,zhishixingqiu,weibo,substack
AUTO_FEED_TAG_MAX_CHARS=6000
AUTO_FEED_TAG_MIN_LENGTH_TWITTER=50
AUTO_FEED_TAG_MIN_LENGTH_YOUTUBE=200
AUTO_FEED_TAG_MIN_LENGTH_PODCAST=200
AUTO_FEED_TAG_MIN_LENGTH_ZSXQ=30
AUTO_FEED_TAG_MIN_LENGTH_WEIBO=30
AUTO_FEED_TAG_MIN_LENGTH_SUBSTACK=200
AUTO_FEED_TAG_MIN_LENGTH_SUBSTACK_NOTE=30

# ===== Substack 抓取（双轨：文章 post + 动态 note）=====
SUBSTACK_CRAWL_NOTES=true
SUBSTACK_BACKFILL_NOTES=50
SUBSTACK_NOTES_PAGE_CAP=10
SUBSTACK_NOTES_INTERVAL=2.0

# ===== News 混合打标 =====
# NEWS_AUTO_TAG_ENABLED: news 打标总开关（EODHD 轻量映射 + CCTV LLM 打标）
NEWS_AUTO_TAG_ENABLED=true
# NEWS_LLM_TAG_SOURCES: 走 LLM 真打标的来源白名单（匹配 author_identifier, 不区分大小写）
# 其余来源若有 EODHD API tags 走轻量映射（零 LLM），无 tags 则跳过
NEWS_LLM_TAG_SOURCES=CCTV
# News LLM 打标文本最小长度（字符），低于此值跳过
AUTO_FEED_TAG_MIN_LENGTH_NEWS=200

# ===== Podcast RSS 订阅抓取 / ASR =====
# 入库：默认拉取 RSS 中最近 N 天的 episode（非固定条数）
PODCAST_FETCH_RECENT_DAYS=7
# 单日过滤后的条目硬上限（防止异常超大 Feed）
PODCAST_FETCH_MAX_ITEMS=100
# 自动 ASR：仅转写最近 N 小时内发布的 episode；更早的仅入库，可手动触发转写
PODCAST_ASR_RECENT_HOURS=48

# ===== 自动向量化（OSS Vector Bucket / 语义检索）=====
# 与 AUTO_TAG_* / AUTO_ANALYZE_* 并列的第 5 路并行任务。处理上传文档与订阅 Feed 的语义索引。
AUTO_VECTORIZE_ENABLED=true
AUTO_VECTORIZE_DELAY=2
# 长度门槛：< MIN 自动跳过（短文全文已可入 prompt），>= FORCE_LONG 强制向量化（超过 Agent _MAX_CONTENT_CHARS=32000）
AUTO_VECTORIZE_MIN_CONTENT_LENGTH=3000
AUTO_VECTORIZE_FORCE_LONG_THRESHOLD=32000
# 超大保护：超过此长度暂不自动向量化，等待人工确认（避免百万字超长文档一次烧光配额）
AUTO_VECTORIZE_MAX_CONTENT_LENGTH=10000000
# 分块参数（中文字符为单位；英文按 token 大致 1 char ≈ 0.3-0.5 token）
CHUNK_TARGET_CHARS=600
CHUNK_OVERLAP_CHARS=80

# ===== Ebook（长文档）识别与 Map-Reduce 摘要 =====
# 满足任一条件即判定为 ebook-class，跳过全量 LLM analyze，改走 Vector RAG + Map-Reduce
EBOOK_MIN_PAGES=80
EBOOK_MIN_CHARS=100000
# Map-Reduce 任务在 vectorize 之后延迟触发（秒），预留向量化完成的时间
EBOOK_MAP_REDUCE_DELAY=150
# Map 阶段每章最大输入字符（超出截断，避免 qwen-turbo 上下文溢出）
EBOOK_MAP_MAX_CHARS=8000
# Reduce 阶段拼接所有章节摘要的最大字符数
EBOOK_REDUCE_MAX_CHARS=32000
# Map/Reduce 使用的 LLM 模板 code（需在 llm_prompt_templates 表中存在）
EBOOK_MAP_TEMPLATE_CODE=ebook_chapter_summary_v1
EBOOK_REDUCE_TEMPLATE_CODE=ebook_book_overview_v1

# ===== PDF 解析安全边界 =====
# 超过此页数拒绝解析（防 OOM）
PDF_MAX_PAGES_HARD_LIMIT=2000
# 超过此页数启用分批流式解析（降低峰值内存）
PDF_STREAMING_THRESHOLD_PAGES=50
# 流式解析每批页数
PDF_STREAMING_BATCH_SIZE=50
# Vector Bucket 配置（生产 .env 覆盖；OSS_VECTOR_BUCKET 留空则跳过初始化）
OSS_VECTOR_BUCKET=
OSS_VECTOR_REGION=cn-hongkong
OSS_VECTOR_ACCOUNT_ID=
OSS_VECTOR_ENDPOINT=
OSS_VECTOR_INDEX=contentchunks
# Twitter 短推智能路由：开启后 <250 字且无 $cashtag 走 tweet_signal_v1，否则走 content_tag_feeds_v1
TWEET_SIGNAL_V1_ENABLED=true
# 重型模板字符阈值（超过此值或含 $TICKER 走 content_tag_feeds_v1）
TWEET_SIGNAL_HEAVY_THRESHOLD_CHARS=250
# 覆盖 tweet_signal_v1 推荐模型（留空使用模板默认 qwen3-plus）
TWEET_SIGNAL_MODEL_OVERRIDE=

# ===== Celery =====
CELERY_CONCURRENCY=4

# ===== HK YouTube Worker 健康监测 + Lark 告警 =====
# 服务状态监测群 webhook；留空则关闭 Lark 推送（探测仍写 Redis）
LARK_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/8ecad972-c0f6-4c27-8330-0b227a494aa2
# 群机器人未开启签名校验时留空
LARK_WEBHOOK_SECRET=
# 知识星球 Scheduler 抓取汇总通知（默认警报机器人群）
ZSXQ_LARK_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/faf6e6eb-dbcc-4c59-9176-fc068e5d08a9
ZSXQ_LARK_NOTIFY_ENABLED=true
# 微博 Scheduler 抓取汇总通知（默认复用警报机器人群）
WEIBO_LARK_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/faf6e6eb-dbcc-4c59-9176-fc068e5d08a9
WEIBO_LARK_NOTIFY_ENABLED=true
# 微博 Cookie Fernet 加密密钥（生产务必在 .env 覆盖为强随机值；留空则 weibo_credential_service 初始化报错）
WEIBO_COOKIE_ENC_KEY=
# Substack Scheduler 抓取汇总通知（默认复用警报机器人群）
SUBSTACK_LARK_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/faf6e6eb-dbcc-4c59-9176-fc068e5d08a9
SUBSTACK_LARK_NOTIFY_ENABLED=true
# Substack 管理员 Cookie Fernet 加密密钥（加密 {"substack.sid":..,"substack.lli":..} JSON；生产务必在 .env 覆盖为强随机值）
SUBSTACK_COOKIE_ENC_KEY=
# 期望在线的 HK worker 主机名（逗号分隔）；默认 Feed 主链路 worker
HK_EXPECTED_WORKERS=youtube-transcription-worker@localhost001
# 连续未命中次数达到阈值后发告警（Beat 每 10min 一次，2 = ~20min）
HK_HEALTH_MISS_THRESHOLD=2
# 离线状态下重复提醒的最小间隔（分钟）
HK_HEALTH_ALERT_COOLDOWN_MIN=60
# control.ping 超时（秒）
HK_HEALTH_PING_TIMEOUT_SEC=5

# ===== 文件处理 / 分析（ASR、LlamaParse 轮询、LLM 单次请求读超时上限）=====
# 单阶段最长等待（分钟）。超时后本地停止等待并返回超时错误；不保证云端任务已取消。
FILE_PROCESSING_TIMEOUT_MINUTES=10

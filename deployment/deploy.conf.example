# ===========================================
# GuanHe Project 部署配置（每台服务器不同）
# 复制为 deploy.conf 并根据实际环境修改
# ===========================================

# ===== 项目标识 =====
APP_NAME=GuanHe Capital
APP_VERSION=2.0.0

# ===== 服务器路径 =====
PROJECT_DIR=/opt/guanhetech
CONDA_ENV=/root/miniconda3/envs/guanhe
VOLTA_DIR=/root/.volta/bin
LOG_DIR=/opt/guanhetech/logs

# ===== 网络/端口 =====
SERVER_HOST=你的服务器公网IP
WEBAPP_PORT=8000
SCHEDULER_PORT=8001
FRONTEND_PORT=3000

# ===== 数据库 =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=postgres

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== RC Agent (Dify 等外部 AI 服务) =====
RC_AGENT_BASE_URL=http://your-dify-server:81/v1/chat-messages

# ===== 代理（境外服务访问，可选）=====
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# YOUTUBE_PROXY=http://127.0.0.1:7890

# ===== 性能调优（根据服务器配置调整）=====
CELERY_AI_CONCURRENCY=2
CELERY_DATA_CONCURRENCY=1
UVICORN_WORKERS=2

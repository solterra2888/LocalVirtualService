[Unit]
Description=GuanHe Project Celery Worker - Data Fetching Queue
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/rcproject

# 从.env文件加载所有配置（包含敏感信息）
EnvironmentFile=/opt/rcproject/.env

# 仅覆盖路径相关的环境变量
Environment=PATH=/root/miniconda3/envs/guanhe/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/opt/rcproject

ExecStart=/root/miniconda3/envs/guanhe/bin/celery -A backend.celery_app worker \
    --loglevel=info \
    --concurrency=1 \
    --queues=data_fetching \
    --hostname=data-worker@%h \
    --max-tasks-per-child=10 \
    --prefetch-multiplier=1 \
    --logfile=/opt/rcproject/logs/celery_data_worker.log \
    --pidfile=/opt/rcproject/logs/celery_data_worker.pid

Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# 性能优化
LimitNOFILE=65536
LimitNPROC=4096

# 优雅停止
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target


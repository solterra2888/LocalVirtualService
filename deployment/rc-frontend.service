[Unit]
Description=GuanHe Project Frontend Application
After=network.target rc-webapp.service
Wants=rc-webapp.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/rcproject/web-frontend

Environment=PATH=/root/.volta/bin:/usr/local/bin:/usr/bin:/bin
Environment=BROWSER=none
# 使用相对路径，通过 Nginx 统一代理，避免 IP 变更时需要修改配置
Environment=REACT_APP_API_BASE_URL=/api
Environment=REACT_APP_SCHEDULER_BASE_URL=/scheduler

ExecStart=/root/.volta/bin/npm start

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

KillSignal=SIGTERM
TimeoutStopSec=15

LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target

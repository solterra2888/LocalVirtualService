[Unit]
Description=RC Project Scheduler Service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=kevin
Group=kevin
WorkingDirectory=/home/kevin/rcproject
Environment=PATH=/home/kevin/miniconda3/envs/rc_project/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/home/kevin/rcproject
Environment=DB_HOST=localhost
Environment=DB_PORT=5432
Environment=DB_NAME=rc_database
Environment=DB_USER=postgres
Environment=DB_PASSWORD=1q23l,Sc45+@!
Environment=SCHEDULER_SERVICE_URL=http://localhost:8001
Environment=DEPLOYMENT_MODE=unified
ExecStart=/home/kevin/miniconda3/envs/rc_project/bin/python /home/kevin/rcproject/scheduler_main.py
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

# 性能优化
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
[Unit]
Description=RC Project - Scheduler Service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/rcproject
Environment=PYTHONPATH=/opt/rcproject
ExecStart=/opt/rcproject/venv/bin/python scheduler_main.py
Restart=always
RestartSec=10

# 环境变量
EnvironmentFile=/opt/rcproject/.env

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rc-scheduler

# 安全设置
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/rcproject/logs

# 资源限制 - 调度器可能需要更多资源
LimitNOFILE=65536
MemoryLimit=4G

[Install]
WantedBy=multi-user.target


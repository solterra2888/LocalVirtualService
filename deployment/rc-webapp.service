[Unit]
Description=RC Project Web Application
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/rcproject

# 从.env文件加载所有配置（包含敏感信息）
EnvironmentFile=/opt/rcproject/.env

# 仅覆盖路径相关的环境变量
Environment=PATH=/home/kevin/miniconda3/envs/rc_project/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/opt/rcproject
ExecStart=/home/kevin/miniconda3/envs/rc_project/bin/python -m uvicorn backend.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

# 性能优化
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
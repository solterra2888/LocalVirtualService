# ============================================================
# YouTube Remote Worker — 家用电脑环境变量配置
# 通过 SSH 隧道连接服务器的 Redis 和 PostgreSQL
# ============================================================

# ===== 数据库（通过 SSH 隧道，本地端口 15432 → 服务器 5432）=====
DB_HOST=127.0.0.1
DB_PORT=15432
DB_NAME=guanhe_database
DB_USER=postgres
DB_PASSWORD=<与服务器相同的数据库密码>

# ===== Redis（通过 SSH 隧道，本地端口 16379 → 服务器 6379）=====
# 注意：密码中的特殊字符需要 URL 编码
REDIS_URL=redis://:<URL编码后的Redis密码>@127.0.0.1:16379/0

# ===== 日志 =====
LOG_DIR=./logs
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_TO_CONSOLE=true

# ============================================================
# YouTube Remote Worker — 家用虚拟机环境变量
# 默认：通过服务器公网 IP 直连 Redis / PostgreSQL（你已做好防火墙与访问控制）
# ============================================================

# ===== 数据库（直连服务器公网，端口以你实际开放为准，一般为 5432）=====
DB_HOST=43.99.37.76
DB_PORT=5432
DB_NAME=guanhe_database
DB_USER=postgres
DB_PASSWORD=<与服务器 /opt/guanhetech/.env 中 DB_PASSWORD 一致>

# ===== Redis / Celery Broker（与服务器 .env 中 REDIS_URL 一致，仅将 127.0.0.1 换为公网 IP）=====
# 示例：若服务器为 redis://:编码后密码@127.0.0.1:6379/0
# 则此处写：redis://:编码后密码@43.99.37.76:6379/0
REDIS_URL=redis://:<URL编码后的Redis密码>@43.99.37.76:6379/0

# ===== 日志 =====
LOG_DIR=./logs
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_TO_CONSOLE=true

# ============================================================
# SSH Tunnel systemd 用户服务
# 安装：
#   mkdir -p ~/.config/systemd/user
#   cp ssh-tunnel.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now ssh-tunnel.service
#
# 前提：
#   1. sudo apt install autossh
#   2. 已配置 SSH 免密登录（ssh-copy-id root@43.99.37.76）
# ============================================================

[Unit]
Description=SSH Tunnel to GuanHe Server (Redis + PostgreSQL)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/autossh -M 0 -N \
    -o "ServerAliveInterval=30" \
    -o "ServerAliveCountMax=3" \
    -o "ExitOnForwardFailure=yes" \
    -L 16379:127.0.0.1:6379 \
    -L 15432:127.0.0.1:5432 \
    root@43.99.37.76

Restart=always
RestartSec=10

[Install]
WantedBy=default.target

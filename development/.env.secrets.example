# ===========================================
# 本地开发 敏感密钥配置（禁止提交 git）
# 复制为 .env.secrets 并填入实际密钥：
#   cp development/.env.secrets.example development/.env.secrets
# ===========================================
# 此文件仅用于本地开发环境。
# 正式服务器部署请使用 deployment/.env.secrets。

# 数据库密码
DB_PASSWORD=your_db_password_here

# 默认管理员密码
DEFAULT_ADMIN_PASSWORD=your_admin_password_here

# JWT 认证密钥（运行 python3 -c "import secrets; print(secrets.token_urlsafe(48))" 生成）
JWT_SECRET_KEY=your_jwt_secret_key_here

# Redis 密码（本地无密码 Redis 必须留空或注释掉，否则上传文件会报 AUTH 错误）
# REDIS_PASSWORD=

# LlamaIndex Cloud API 密钥
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key_here
# LlamaCloud 区域: us（默认）或 eu —— 影响 API 端点 URL
# LLAMA_CLOUD_REGION=us
# 或直接指定完整 Base URL（优先级高于 REGION）:
# LLAMA_CLOUD_BASE_URL=https://api.cloud.llamaindex.ai

# EODHD 市场数据 API 密钥
EODHD_API_TOKEN=your_eodhd_api_token_here

# Twitter/X API 密钥
TWITTER_API_KEY=your_twitter_api_key_here

# 阿里云通义千问 API 密钥
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 阿里云 OSS
OSS_ACCESS_KEY_ID=your_oss_access_key_id_here
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret_here

# RC Agent 令牌
RC_AGENT_TOKEN=your_rc_agent_token_here

# YouTube Data API v3 密钥（可选）
YOUTUBE_DATA_API_KEY=your_youtube_data_api_key_here

# 知识星球（ZSXQ）管理员 Cookie 加密密钥（Fernet 对称加密，存储于 zsxq_credentials 表）
# 生成方法：python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️ 密钥一旦修改，已加密的 Cookie 将无法解密，需重新录入。
ZSXQ_COOKIE_ENC_KEY=your_zsxq_cookie_enc_key_here

# Substack 管理员 Cookie 加密密钥（Fernet；加密 {"substack.sid":..,"substack.lli":..} JSON）
# 生成方法同上
SUBSTACK_COOKIE_ENC_KEY=your_substack_cookie_enc_key_here

# 注: TWEET_SIGNAL_V1_ENABLED 等 feed 打标开关在 deployment/config.defaults.env 中配置

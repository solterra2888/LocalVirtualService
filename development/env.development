# ================================
# 数据库连接配置 (远程数据库)
# ================================
DB_HOST=111.230.48.119
DB_PORT=5432
DB_NAME=rc_database
DB_USER=postgres
DB_PASSWORD=1q23l,Sc45+@!

# ================================
# 服务地址配置 (本地服务)
# ================================
SCHEDULER_SERVICE_URL=http://localhost:8001
WEBAPP_URL=http://localhost:8000

# 后端服务配置 (用于文件访问)
BACKEND_HOST=localhost
BACKEND_PORT=8000

# 本地调度器配置
LOCAL_SCHEDULER_ENABLED=true
SCHEDULER_HOST=0.0.0.0
SCHEDULER_PORT=8001

# ================================
# 部署模式配置
# ================================
DEPLOYMENT_MODE=development

# ================================
# 前端环境变量 (React)
# ================================
REACT_APP_API_BASE_URL=http://localhost:8000/api
REACT_APP_SCHEDULER_BASE_URL=http://localhost:8001/api
REACT_APP_RC_AGENT_BASE_URL=http://111.230.48.119:81/v1/chat-messages

# ================================
# 开发环境特定配置
# ================================
# 日志级别
LOG_LEVEL=DEBUG
LOG_TO_CONSOLE=true
LOG_TO_FILE=true

# 环境标识
ENVIRONMENT=development

# ================================
# Python路径配置
# ================================
PYTHONPATH=/home/kevin/rcproject

# ================================
# RC Agent配置
# ================================
RC_AGENT_BASE_URL=http://111.230.48.119:81/v1/chat-messages

# ================================
# Celery异步任务配置
# ================================
# Redis连接配置
REDIS_URL=redis://localhost:6379/0

# Celery Worker配置
CELERY_CONCURRENCY=2
CELERY_LOG_LEVEL=info

# Flower监控配置
FLOWER_PORT=5555
# FLOWER_AUTH=admin:Strive4it  # 注释掉以避免Flower 2.0.1的认证bug

# ================================
# 其他开发配置
# ================================
# 浏览器自动打开 (前端开发)
BROWSER=none

# Node.js环境
NODE_ENV=development

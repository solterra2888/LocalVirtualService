# GuanHe Project 全服务器统一部署环境配置
# 适用于43.99.37.76服务器上的所有服务
# ===========================================
# 数据库配置 (PostgreSQL - 本地)
# ===========================================
DB_HOST=43.99.37.76
DB_PORT=5432
DB_NAME=rc_database
DB_USER=postgres
DB_PASSWORD=1q23l,Sc45+@!
# ===========================================
# 默认管理员账户
# ===========================================
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=Strive4it
# ===========================================
# Market Data Service 并发配置
# ===========================================
# 并发获取市场数据的线程数
# 默认: 10
# 推荐范围: 5-20 (根据资产数量调整)
# 70个资产: 10 | 100个资产: 10-15 | 150个资产: 15-20
MARKET_DATA_MAX_WORKERS=10
# ===========================================

连接数据库，需要先激活conda 环境`rcTool`
# ===========================================
# 网络代理配置（国内服务器访问 YouTube / Twitter 等境外服务必填）
# ===========================================
# YOUTUBE_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ===========================================
# Agent / MCP (Personal Access Token rate limit)
# ===========================================
# 默认每分钟每 PAT 60 次请求；设为 0 关闭 PAT 限速（不推荐）
# AGENT_PAT_RATE_LIMIT_PER_MIN=60
# 前端深链 / Agent JSON 中的 url 字段（填写服务器公网地址，不含结尾斜杠）
PUBLIC_WEB_URL=http://43.99.37.76
# ===========================================
# 知识星球（ZSXQ）Cookie 加密密钥
# ===========================================
# 用于 Fernet 对称加密存储管理员 Cookie（zsxq_credentials 表）。
# 生成方法（运行一次后把输出粘贴到此处）：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️ 密钥一旦修改，已加密的 Cookie 将无法解密，需要重新录入。
ZSXQ_COOKIE_ENC_KEY=
# ===========================================
# Lark 机器人事件订阅
# ===========================================
# 飞书开放平台 → 事件订阅 → Verification Token
LARK_ROBOT_VERIFICATION=

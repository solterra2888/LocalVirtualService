# LLM配置示例文件
# 请复制此文件为 .env 并填入实际的API密钥

# ===========================================
# 通义千问配置
# ===========================================
QWEN_ENABLED=true
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com
QWEN_DEFAULT_MODEL=qwen-turbo
QWEN_MAX_TOKENS=2000
QWEN_TEMPERATURE=0.7
QWEN_TOP_P=0.8

# ===========================================
# 豆包配置
# ===========================================
DOUBAO_ENABLED=true
DOUBAO_API_KEY=your_doubao_api_key_here
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com
DOUBAO_DEFAULT_MODEL=doubao-seed-1-6-250615
DOUBAO_MAX_TOKENS=4000
DOUBAO_TEMPERATURE=0.7
DOUBAO_TOP_P=0.9


# ===========================================
# 智谱GLM配置
# ===========================================
GLM_ENABLED=false
GLM_API_KEY=your_glm_api_key_here
GLM_BASE_URL=https://open.bigmodel.cn
GLM_DEFAULT_MODEL=glm-4.6
GLM_MAX_TOKENS=8000
GLM_TEMPERATURE=0.7
GLM_TOP_P=0.8

# ===========================================
# 全局LLM设置
# ===========================================
# 默认使用的LLM提供商
DEFAULT_LLM_PROVIDER=qwen

# 是否启用故障转移
LLM_FALLBACK_ENABLED=true

# 故障转移顺序（逗号分隔）
LLM_FALLBACK_ORDER=qwen,doubao,glm

# 请求超时时间（秒）
LLM_TIMEOUT=30

# 重试次数
LLM_RETRY_COUNT=3

# 是否启用详细日志
LLM_ENABLE_LOGGING=true

# 是否启用性能监控
LLM_ENABLE_MONITORING=true

[Unit]
Description=YT Worker - main (youtube_fetching + youtube_transcription)
After=network-online.target
Wants=network-online.target
PartOf=yt-worker.target

[Service]
Type=simple
WorkingDirectory=/opt/local_virtual_service
# systemd 启动时不继承 shell 环境，conda 不在默认 PATH 里
Environment="HOME=/root"
Environment="PATH=/root/miniconda3/envs/yt_service/bin:/root/miniconda3/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/bin/bash /opt/local_virtual_service/run_worker.sh main
Restart=always
RestartSec=30
OOMScoreAdjust=-200
StandardOutput=append:/opt/local_virtual_service/logs/worker.log
StandardError=append:/opt/local_virtual_service/logs/worker.log

[Install]
WantedBy=yt-worker.target

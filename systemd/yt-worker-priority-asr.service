[Unit]
Description=YT Worker - priority ASR (youtube_transcription_priority, Upload Link ASR)
After=network-online.target
Wants=network-online.target
PartOf=yt-worker.target

[Service]
Type=simple
WorkingDirectory=/opt/local_virtual_service
Environment="HOME=/root"
Environment="PATH=/root/miniconda3/envs/yt_service/bin:/root/miniconda3/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/bin/bash /opt/local_virtual_service/run_worker.sh priority-asr
Restart=always
RestartSec=30
# priority-asr 和 main worker 并发跑 OSS 上传，内存/带宽峰值较高
OOMScoreAdjust=-200
StandardOutput=append:/opt/local_virtual_service/logs/worker.log
StandardError=append:/opt/local_virtual_service/logs/worker.log

[Install]
WantedBy=yt-worker.target

[Unit]
Description=YouTube Transcription Workers (single-node: all queues)
# 单机全栈：main + long + priority*。双节点请改用 yt-worker-caption / yt-worker-asr-node target
Wants=yt-worker-main.service
Wants=yt-worker-long.service
Wants=yt-worker-priority-transcript.service
Wants=yt-worker-priority-asr.service
After=network-online.target

[Install]
WantedBy=multi-user.target

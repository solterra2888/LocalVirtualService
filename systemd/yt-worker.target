[Unit]
Description=YouTube Transcription Workers (all queues)
# Wants 四个 worker unit；systemctl restart yt-worker.target 一键重启全部
Wants=yt-worker-main.service
Wants=yt-worker-long.service
Wants=yt-worker-priority-transcript.service
Wants=yt-worker-priority-asr.service
After=network-online.target

[Install]
WantedBy=multi-user.target

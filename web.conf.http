# ===========================================
# 纯 HTTP 站点配置（无域名 / 无 SSL 证书时使用）
# deploy.sh / start_services.sh 会将 web.conf 同步到
# /opt/nginx/conf/vhosts/web.conf
#
# 使用方法：cp web.conf.http web.conf
# ===========================================

# 定义后端服务的上游（Upstream）
upstream rc_webapp {
    server 127.0.0.1:8000;
}

upstream rc_scheduler {
    server 127.0.0.1:8001;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html/guanhe;
    index index.html;

    access_log /var/log/nginx/rc_project_access.log acc;
    error_log /var/log/nginx/rc_project_error.log;

    # 安全响应头
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;

    # 1. 前端路由处理：支持 React/Vue 的 History 模式
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 2. 静态资源缓存
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|otf)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # 3. MCP 包下载（wheel 文件，pip install 使用）
    location /downloads/ {
        proxy_pass http://rc_webapp;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }

    # 4. Agent Skill 文档（FastAPI StaticFiles mount，不在 /api/ 前缀下）
    location /agent/skill/ {
        proxy_pass http://rc_webapp;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
    }

    # 5. 后端 API 代理
    location /api/ {
        proxy_pass http://rc_webapp;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        client_max_body_size 2048M;
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        proxy_request_buffering off;
    }

    # 6. 音频上传（更长超时）
    location /api/files/upload-audio {
        proxy_pass http://rc_webapp;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        client_max_body_size 2048M;
        client_body_timeout 600s;
        proxy_connect_timeout 60s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
        proxy_request_buffering off;
    }

    # 7. 调度器接口代理
    location /scheduler/ {
        proxy_pass http://rc_scheduler/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 健康检查
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    # 禁止访问隐藏文件（如 .env, .git）
    location ~ /\. {
        deny all;
    }

    # 禁止访问敏感后缀文件
    location ~ \.(env|log|sql)$ {
        deny all;
    }
}
